<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hexervoodoom.soulmon">

    <!-- Backup: mantido LIGADO (não quebra quem já joga), mas com regra de
         exclusão do diretório do WebView, onde vive o localStorage — o save e,
         principalmente, `soulmon-profile` (nome completo, data, hora e local de
         nascimento). Sem essas regras o Auto Backup exportava essa PII para o
         Google Drive. Ver os comentários em res/xml/backup_rules.xml. -->
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- WIDGET A — horizontal (sprite + info ao lado) -->
        <receiver
            android:name=".widget.SoulmonWidgetProvider"
            android:label="Soulmon"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/soulmon_widget_info" />
        </receiver>

        <!-- WIDGET B — vertical (sprite + info embaixo) -->
        <receiver
            android:name=".widget.SoulmonWidgetVerticalProvider"
            android:label="Soulmon Vertical"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/soulmon_widget_vertical_info" />
        </receiver>

        <!-- WIDGET C — pet only -->
        <receiver
            android:name=".widget.SoulmonWidgetPetProvider"
            android:label="Soulmon Pet"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/soulmon_widget_pet_info" />
        </receiver>

        <!-- WIDGET D — chat (pet animado + frases girando) -->
        <receiver
            android:name=".widget.SoulmonWidgetChatProvider"
            android:label="Soulmon Chat"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/soulmon_widget_chat_info" />
        </receiver>

        <!-- WIDGET E — tela do pet (grade + corações + pet + barra de energia) -->
        <receiver
            android:name=".widget.SoulmonWidgetScreenProvider"
            android:label="Soulmon Tela"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/soulmon_widget_screen_info" />
        </receiver>

        <receiver
            android:name=".notifications.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- usuário concedeu/revogou "Alarmes e lembretes": reagendar (doc oficial de alarmes) -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- FCM (remote push): default icon/channel used when the app is in the
             background — Firebase Messaging auto-displays the notification using
             these. The "soulmon_push" channel is created in MainActivity. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="soulmon_push" />

    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Contador de passos (@capgo/capacitor-pedometer → Sensor.TYPE_STEP_COUNTER).
         O manifesto do plugin já declara esta permissão e o merger a traria de
         qualquer jeito; está repetida aqui DE PROPÓSITO, porque é a permissão
         que aparece na ficha do Play e precisa estar visível para quem revisa o
         app sem abrir node_modules. Runtime simples desde a API 29 — NÃO é
         Health Connect: nada de conta de organização verificada, declaração de
         dados de saúde ou política dedicada. Opcional: o app roda inteiro sem
         ela (ver src/utils/steps.ts). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>
    <!-- Microfone, para o recado FALADO ao bichinho (ChatBox → /api/transcribe).
         Runtime, e OPCIONAL do mesmo jeito que o contador de passos: negar não
         impede nada além de gravar — o campo de texto continua inteiro.

         ⚠️ TRÊS COISAS ANDAM JUNTAS, e separar qualquer uma quebra a ficha do
         Play sem quebrar o build:
           1. esta permissão;
           2. `public/privacidade.html`, que declara a coleta e o destino;
           3. `docs/PLAY-DATA-SAFETY.md`, que é o que se preenche no console.
         O guard `src/security/supabase.contract.test.ts` liga as três: se a
         funcionalidade ligar sem as declarações, ele fica vermelho.

         O áudio NÃO é gravado em disco nem no servidor: é repassado ao
         provedor de transcrição e o que volta é texto. Não há
         `FOREGROUND_SERVICE_MICROPHONE` porque nada grava em segundo plano —
         a gravação existe só enquanto a tela do chat está aberta e a pessoa
         está com o botão apertado. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
</manifest>
