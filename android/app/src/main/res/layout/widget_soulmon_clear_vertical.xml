<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Soulmon" sem moldura, formato VERTICAL (beta12 A2): 1 celula de largura x 2+ de altura. A criatura em cima e a
     fala ABAIXO dela (no horizontal fica a direita). Mesmo estilo do clear: texto branco com sombra, so a fala numa caixa
     escura de baixa opacidade. Somente LinearLayout/ViewFlipper/ImageView/TextView (RemoteViews). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="4dp"
    android:gravity="center_horizontal">

    <ViewFlipper
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoStart="true"
        android:flipInterval="450">
        <ImageView
            android:id="@+id/widget_sprite"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:src="@drawable/sprite_starter_industrial" />
        <ImageView
            android:id="@+id/widget_sprite_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:paddingTop="4dp"
            android:contentDescription="@null"
            android:src="@drawable/sprite_starter_industrial" />
    </ViewFlipper>

    <TextView
        android:id="@+id/widget_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_clear_speech"
        android:padding="5dp"
        android:gravity="center_horizontal"
        android:textSize="11sp"
        android:textColor="#FFFFFF"
        android:shadowColor="#FF000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="2.5"
        android:maxLines="5"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_pet_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_horizontal"
        android:text="Soulmon"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#FFFFFF"
        android:shadowColor="#FF000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="2.5"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
