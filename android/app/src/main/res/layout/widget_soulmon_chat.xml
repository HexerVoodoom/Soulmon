<?xml version="1.0" encoding="utf-8"?>
<!-- Widget D "Soulmon (chat)" 3x1 (180x40dp): 34dp uteis = criatura 32 + nome 13sp + frase 12sp
     (= 31). A LINHA DO CONTADOR SAI (F1/V6, excecao registrada em DECISOES §30 (b)) - e com
     zero tarefas nao aparece NADA alem disso (13.16: nem "0/5" nem um traco). As frases giram
     no ViewFlipper (15 s); teto do pool ~22 caracteres (§30 (c), `redator-ux`), ellipsize como rede. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:paddingStart="11dp"
    android:paddingEnd="11dp"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical">

    <ViewFlipper
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:autoStart="true"
        android:flipInterval="450">
        <ImageView
            android:id="@+id/widget_sprite"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitEnd"
            android:contentDescription="@null"
            android:src="@drawable/sprite_rookie" />
        <ImageView
            android:id="@+id/widget_sprite_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitEnd"
            android:paddingTop="2dp"
            android:contentDescription="@null"
            android:src="@drawable/sprite_rookie" />
    </ViewFlipper>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_pet_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Soulmon"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#E9F5F2"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />

        <ViewFlipper
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoStart="true"
            android:flipInterval="15000">
            <TextView android:id="@+id/widget_phrase_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#E9F5F2" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_phrase_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#E9F5F2" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_phrase_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#E9F5F2" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_phrase_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#E9F5F2" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_phrase_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#E9F5F2" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        </ViewFlipper>

    </LinearLayout>

</LinearLayout>
