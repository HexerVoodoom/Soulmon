<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Companheiro" (beta12 A3): um unico bitmap quadrado (criatura GRANDE + moldura + LCD) desenhado por
     WidgetRenderer.renderCompanion; o ImageView escala para o tamanho colocado (2x2, 3x3...). So FrameLayout/ImageView (RemoteViews). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_vpet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_companion_content"
        android:src="@drawable/vpet_moldura" />
</FrameLayout>
