---
import '../styles/tokens.css';
import '../styles/site.css';
import { TEXTOS, type Lang } from '../i18n/textos';
import { b } from '../lib/base';
import assets from '../content/assets.json';
interface Props { lang: Lang; titulo?: string; desc?: string; alternativa: string; aqui: string; preload?: boolean; noindex?: boolean }
const { lang, titulo, desc, alternativa, aqui, preload = false, noindex = false } = Astro.props;
const t = TEXTOS[lang];
const base = Astro.site!.origin;
// Peças trocáveis viram variáveis CSS: trocar o manifesto não muda layout (src/content/assets.json).
const vars = Object.entries(assets).flatMap(([k, v]) => {
  if (k.startsWith('_') || typeof v === 'string' || !v.src) return [];
  const m = v as { src: string; fatia?: string; borda?: string; borda3?: string };
  return [`--a-${k}:url(${b(m.src)})`, ...(m.fatia ? [`--f-${k}:${m.fatia} fill`, `--b-${k}:${m.borda}`, ...(m.borda3 ? [`--b3-${k}:${m.borda3}`] : [])] : [])];
}).join(';');
const heroArte = (assets as unknown as { heroArte?: { celular: string | null; desktop: string | null; larguras: { celular: number[]; desktop: number[] } } }).heroArte;
const hrefPt = lang === 'pt' ? aqui : alternativa;
const hrefEn = lang === 'en' ? aqui : alternativa;
---
<!doctype html>
<html lang={t.html} style={vars}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{titulo ?? t.titulo}</title>
  <meta name="description" content={desc ?? t.desc} />
  <meta name="theme-color" content="#071413" />
  {noindex ? <meta name="robots" content="noindex" /> : <>
    <link rel="canonical" href={base + aqui} />
    <link rel="alternate" hreflang="pt-BR" href={base + hrefPt} />
    <link rel="alternate" hreflang="en" href={base + hrefEn} />
    <link rel="alternate" hreflang="x-default" href={base + hrefEn} />
  </>}
  <link rel="icon" href={b('/favicon-192.png')} />
  <meta property="og:title" content={titulo ?? t.titulo} />
  <meta property="og:description" content={desc ?? t.desc} />
  <meta property="og:image" content={base + b('/og.png')} />
  <meta property="og:type" content="website" />
  <link rel="preload" href={b('/fonts/cinzel-latin.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={b('/fonts/rubik-latin.woff2')} as="font" type="font/woff2" crossorigin />
  {/* LCP medido é a criatura protagonista (o mapa em tela cheia não entra como candidato): ela vem primeiro, o mapa logo atrás. */}
  {/* Hero: arte-chave quando existir (só a variante da tela); senão a criatura protagonista. */}
  {preload && heroArte?.celular ? <>
    <link rel="preload" as="image" type="image/avif" fetchpriority="low" media="(max-width: 1023px)" imagesrcset={heroArte.larguras.celular.map((w: number) => `${b(heroArte.celular)}-${w}.avif ${w}w`).join(', ')} imagesizes="100vw" />
    <link rel="preload" as="image" type="image/avif" fetchpriority="high" media="(min-width: 1024px)" imagesrcset={heroArte.larguras.desktop.map((w: number) => `${b(heroArte.desktop)}-${w}.avif ${w}w`).join(', ')} imagesizes="100vw" />
  </> : preload && <link rel="preload" as="image" type="image/webp" fetchpriority="high" href={b('/sprites/fogo-ultimate.webp')} />}
</head>
<body>
  <slot />
</body>
</html>
