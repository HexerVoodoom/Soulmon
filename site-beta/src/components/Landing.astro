---
// Página do beta, v3 (docs/site-beta/PLANO-DESIGN.md): "cada rolagem é um lugar".
// 0 barra superior · 1 hero (Exploração) · 2 o jogo na sua mão: aparelho real + demo (Laboratório) · 4 seu Soulmon (Jogos)
// 5 o universo (Hall) · 6 o que você faz (Arena) · 7 trailer (slot, só com midia.trailer.ativo) · 8 como entrar (painel calmo)
// 9 perguntas · 10 entre no beta (Guilda inteira). Ritmo: cena cheia x painel calmo, sem superfície clara.
import Base from '../layouts/Base.astro';
import '../styles/ramos.css';
import { existsSync } from 'node:fs';
import { b } from '../lib/base';
import Mapa from './Mapa.astro';
import Cria from './Cria.astro';
import Aparelho from './Aparelho.astro';
import midia from '../content/midia.json';
import assets from '../content/assets.json';
import universoDados from '../content/universo.json';
import elenco from '../content/elenco.json';
import fusoes from '../content/fusoes.json';
import { TEXTOS, CONTATO, TERMOS, type Lang } from '../i18n/textos';
interface Props { lang: Lang; variante?: 'b' }
const { lang, variante } = Astro.props;
const VB = variante === 'b'; // Versão B (dono, 09/11): sem sorteio e sem demo de scroll; companheiro que evolui rolando.
const t = TEXTOS[lang];
const c = t.ciclo; const s = t.soul; const u = t.universo; const e = t.entrar; const f = t.form; const j = t.jogo; const r = t.recursos; const mo = t.modal;
type Video = { src: string; poster: string; posterAvif?: string; posterP?: string; posterPAvif?: string; gameplay: boolean; legenda: string; largura: number; altura: number };
type Print = { id: string; src: string; gameplay: boolean };
// Gameplay: só captura real (gameplay: true). O trailer é edição (rótulo Trailer); a cinemática de abertura ficou fora da v3.
const loopRaw = (midia.videos[lang] as Video[]).find((v) => v.gameplay === true && v.src);
const loop = loopRaw && { ...loopRaw, src: b(loopRaw.src), poster: b(loopRaw.poster), posterAvif: loopRaw.posterAvif && b(loopRaw.posterAvif), posterP: b(loopRaw.posterP!), posterPAvif: loopRaw.posterPAvif && b(loopRaw.posterPAvif) };
const prints = (midia.prints[lang] as Print[]).filter((p) => p.gameplay === true && p.src);
// Trailer: edição com telas reais, cartelas e arte aprovada ainda fora do jogo. Rótulo próprio, nunca gameplay.
const trailerSlot = (midia as unknown as { trailer?: Record<string, { ativo?: boolean; src: string; poster: string; posterP: string; largura: number; altura: number }> }).trailer?.[lang];
const capa = (trailerSlot as unknown as { capa: { desktop: string; celular: string } }).capa;
const trailer = trailerSlot?.ativo ? { ...trailerSlot, src: b(trailerSlot.src), poster: b(trailerSlot.poster), posterP: b(trailerSlot.posterP) } : undefined; // só com ativo:true (trailer conferido quadro a quadro em 06/11)
// Arte-chave do hero (decisão do dono, 06/11): quando existir, substitui mapa + elenco sem mudar layout.
const heroArte = assets.heroArte as { desktop: string | null; celular: string | null; larguras?: { desktop: number[]; celular: number[] } };
const hset = (base: string, ws: number[], ext: string) => ws.map((w) => `${b(base)}-${w}.${ext} ${w}w`).join(', ');
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '';
const strings = {
  share: f.shareTxt, copiado: f.copiado, falhaCopia: f.falhaCopia, erros: f.erros, enviando: f.enviando,
  forma: c.forma, de: c.de, alt: c.alt, formas: c.formas, nomes: c.nomes, contato: CONTATO, okH: f.okH, ok: f.ok, esperaH: f.esperaH, espera: f.espera, feito: f.feito,
  cta: t.cta, ctaEspera: t.ctaEspera, vagasEspera: t.hero.vagasEspera, enviarEspera: f.enviarEspera, pausar: j.pausar, tocar: j.tocar,
};
const logo = b(assets.logo.src);
const passos = [assets.passoCard1.src, assets.passoCard2.src, assets.passoCard3.src].map(b);
const HABITA = universoDados.habitantes as Record<string, string>;
const NPCS = ['hall', 'jogos', 'oraculo', 'laboratorio-biblioteca-glifa', 'exploracao', 'cuidados', 'loja-itens', 'loja-decoracao', 'loja-background', 'onboarding', 'ranking-arauto', 'n-cozinheiro', 'n-broto', 'n-corvo', 'laboratorio-pet', 'n-musa'];
const ELS = Object.keys(u.els);
// Vinheta de cada lugar: recorte AMPLIADO num ponto diferente dos fundos de seção (x, y em % do mapa).
// Cards com o prédio do jogo no lugar do recorte do mapa (dono, 09/11): Forja = Forja de Alma (Hexsmith), Mercado = tenda da Feira.
const PREDIO: Record<string, string> = { forja: '/site/card-forja-mapa.webp', hall: '/site/card-mercado-mapa.webp' };
const FOCO: Record<string, [number, number]> = { exploracao: [70, 34], jogos: [40, 62], arena: [72, 48], hall: [28, 20], guilda: [28, 30], laboratorio: [70, 50], forja: [50, 50] };
// Capas dos jogos: arte ilustrada 4:3 (public/jogos, src/tools/preparar-capas-jogos.mjs). Título e selo são HTML, nunca na arte.
const capaJogo = (id: string, w: 400 | 800 = 400) => b(`/jogos/capa-${id}-${w}`);
const capaSet = (id: string, ext: string) => `${capaJogo(id, 400)}.${ext} 400w, ${capaJogo(id, 800)}.${ext} 800w`;
const MOSAICO = ['combina', 'arena', 'mente', 'ppt'];
// Só o modal de Jogos mostra os cardzinhos (dono, 09/11); Arena, Exploração e os outros lugares ficam sem.
const JOGOS_POR_LUGAR: Record<string, string[]> = { jogos: ['ppt', 'combina', 'barrage', 'mente', 'corrida'] };
const Formas = c.formas;
// Árvore inteira (dono, 09/11): os 3 caminhos de cada linha. O caminho principal usa o sprite da linha; os outros vêm de E:\Soulmon-assets\...\ramos (public/sprites/ramos).
const CAMINHOS = ['poder', 'harmonia', 'benevolencia'];
const PRINCIPAL: Record<string, string> = { fogo: 'poder', fada: 'benevolencia', planta: 'harmonia', noturno: 'poder' };
// Linha "Noturno" (corvinho roxo do dono, 09/11): entra sozinha quando os 5 sprites existirem em public/sprites/
// (noturno-<forma>.webp e noturno-<forma>-128.webp; formas = c.formas). Caminhos paralelos opcionais em public/sprites/ramos/noturno-<caminho>-<forma>-128.webp;
// sem eles, os outros caminhos aparecem em sombra. Com a linha pronta, ela vira a criatura da demo do scroll (no lugar do fogo).
// Ordem invertida pelo dono (10/11) na linha Fada: Benevolência Champion<->Mega, Harmonia Ultimate<->Mega.
const TROCA: Record<string, string> = { 'fada-benevolencia-champion': 'mega', 'fada-benevolencia-mega': 'champion', 'fada-harmonia-ultimate': 'mega', 'fada-harmonia-mega': 'ultimate' };
const temSprite = (rel: string) => existsSync(`public${rel}`);
const temForma = (lin: string, fm: string) => temSprite(`/sprites/${lin}-${fm}.webp`) && temSprite(`/sprites/${lin}-${fm}-128.webp`);
// Árvore: entra com Champion..Ultra (o Rookie, se faltar, fica em sombra). Demo: só com as 5 formas.
const NOTURNO = c.formas.slice(1).every((fm) => temForma('noturno', fm));
const LINHAS_B = ['arcano','espaco','fada','fogo','morte','noturno','planta','sombra','vigor','vileza'];
const LINHA_DEMO = c.formas.every((fm) => temForma('noturno', fm)) ? 'noturno' : 'fogo';
const LINHAS = [['planta', s.linhas[0]], ['fada', s.linhas[1]], ['fogo', s.linhas[2]], ...(NOTURNO ? [['noturno', s.linhaNoturno]] : [])] as [string, string][];
// Sorteio: todo o elenco elegível de soulmon/novos (src/tools/elenco.mjs). Compacto: [id, elemento, forma].
// Linha Som fora do sorteio (dono, 09/11: era o "sapinho").
const POOL = JSON.stringify(elenco.elegiveis.filter((x) => x.el && !x.el.split(',').includes('som')).map((x) => [x.id, x.el, x.forma]));
const lugarDados = universoDados.lugares as Record<string, { npc: string; pt: string; en: string; habita: { pt: string; en: string } }>;
const falas = JSON.stringify(Object.fromEntries(Object.entries(lugarDados).map(([k, v]) => [k, { fala: v[lang], habita: v.habita[lang], npc: b(v.npc) }])));
const printSrc = (id: string, ext: string) => [240, 480, 720].map((w) => `${b(`/print/${id}-${lang}-${w}.${ext}`)} ${w}w`).join(', ');
const cen = (n: string) => `--cen-m:image-set(url(${b(`/dono/${n}-800.avif`)}) type("image/avif"), url(${b(`/dono/${n}-800.webp`)}) type("image/webp"));--cen-d:image-set(url(${b(`/dono/${n}-1400.avif`)}) type("image/avif"), url(${b(`/dono/${n}-1400.webp`)}) type("image/webp"))`;
const vazio = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
// Trailer vertical (celular) entra sozinho quando public/video/trailer-<lang>-v.mp4 existir.
const TRAILER_V = temSprite(`/video/trailer-${lang}-v.mp4`);
// Idioma por bandeira (dono, 09/11): a bandeira é a do OUTRO idioma.
const MAO_SVG = `<svg viewBox="-1 0 22 15" width="66" height="45" shape-rendering="crispEdges"><g fill="#101418"><rect x='8' y='2' width='11' height='5'/><rect x='2' y='3' width='10' height='11'/><rect x='9' y='5' width='5' height='4'/><rect x='9' y='7' width='5' height='4'/><rect x='9' y='9' width='4' height='4'/><rect x='4' y='1' width='6' height='4'/><rect x='-1' y='2' width='5' height='12'/></g><g fill="#fff"><rect x='9' y='3' width='9' height='3'/><rect x='3' y='4' width='8' height='9'/><rect x='10' y='6' width='3' height='2'/><rect x='10' y='8' width='3' height='2'/><rect x='10' y='10' width='2' height='2'/><rect x='5' y='2' width='4' height='2'/><rect x='0' y='3' width='3' height='10'/></g><g fill="#b8c4cc"><rect x='10' y='8' width='3' height='0.6'/><rect x='10' y='10' width='3' height='0.6'/><rect x='2' y='3' width='1' height='10'/><rect x='4' y='12' width='6' height='1'/></g></svg>`;
const PASSO_HREF = ['https://groups.google.com/g/soulmon-testers', 'https://play.google.com/apps/testing/com.soulmon', 'https://play.google.com/store/apps/details?id=com.soulmon'];
const IG = '<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5.2"/><circle cx="12" cy="12" r="4.1"/><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"/></svg>';
const BANDEIRA_PT = '<svg class="bandeira" viewBox="0 0 28 20" width="34" height="24" aria-hidden="true"><rect width="28" height="20" rx="3" fill="#009c3b"/><path d="M14 2.5 25.5 10 14 17.5 2.5 10Z" fill="#ffdf00"/><circle cx="14" cy="10" r="4.6" fill="#002776"/><path d="M9.6 9.1c3-.9 6.2-.5 8.8 1.2" stroke="#fff" stroke-width=".9" fill="none"/></svg>';
const BANDEIRA_EN = '<svg class="bandeira" viewBox="0 0 60 40" width="34" height="24" aria-hidden="true"><clipPath id="bq"><rect width="60" height="40" rx="6"/></clipPath><g clip-path="url(#bq)"><rect width="60" height="40" fill="#012169"/><path d="M0 0 60 40M60 0 0 40" stroke="#fff" stroke-width="8"/><path d="M0 0 60 40M60 0 0 40" stroke="#c8102e" stroke-width="3"/><path d="M30 0v40M0 20h60" stroke="#fff" stroke-width="12"/><path d="M30 0v40M0 20h60" stroke="#c8102e" stroke-width="7"/></g></svg>';
const PLAY = '<svg class="loja-ico" viewBox="0 0 24 26" width="28" height="30" aria-hidden="true"><path fill="#00d7fe" d="M1.2.6 13.4 12.9 1.2 25.2C.8 25 .5 24.5.5 23.9V2C.5 1.4.8.9 1.2.6Z"/><path fill="#00f076" d="M17.6 8.7 13.4 12.9 1.2.6c.4-.3 1-.3 1.6 0Z"/><path fill="#ff3a44" d="M17.6 17.1 2.8 25.3c-.6.3-1.2.3-1.6-.1l12.2-12.3Z"/><path fill="#ffd400" d="m17.6 8.7 4.6 2.6c1.3.7 1.3 2.2 0 2.9l-4.6 2.9-4.2-4.2Z"/></svg>';
// Colete (dono, 09/11, rodada 3): 8 posições por caminho, 3 visíveis + slide. Reveladas primeiro, o resto em sombra com "?".
const COLETE: Record<string, Record<string, [string, string][]>> = {
  champion: { poder: [['/sprites/fogo-champion-128.webp', u.els.fogo], ['/sprites/colete/champion/agua.webp', t.colete.nomes.agua], ['/sprites/colete/champion/industrial.webp', t.colete.nomes.industrial]] },
  ultimate: { poder: [['/sprites/colete/ultimate/chama_azul.webp', t.colete.nomes.chama_azul], ['/sprites/colete/ultimate/brinquedo.webp', t.colete.nomes.brinquedo], ['/sprites/colete/ultimate/raiz_profunda.webp', t.colete.nomes.raiz_profunda]] },
};
---
<Base lang={lang} alternativa={VB ? t.outraHome + 'b/' : t.outraHome} aqui={VB ? t.home + 'b/' : t.home} canonico={t.home} versaoB={VB ? undefined : t.home + 'b/'} preload>
  <a class="pular" href="#conteudo">{t.pular}</a>

  <header class="topo" data-topo>
    <a class="topo-logo" href="#topo" aria-label={t.logoTopo}><img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-tarde-src={b('/marca/logo-160.webp')} width="160" height="120" alt="" /></a>
    <a class="ig ig-topo" href="https://www.instagram.com/soulmon.app/" target="_blank" rel="noopener noreferrer" aria-label={lang === 'pt' ? 'Instagram do Soulmon' : 'Soulmon on Instagram'} title="Instagram"><Fragment set:html={IG} /></a>
    <a class="idioma" href={VB ? t.outraHome + 'b/' : t.outraHome} hreflang={t.outraCod} lang={t.outraCod} aria-label={t.outraNome} title={t.outraNome}><Fragment set:html={lang === 'pt' ? BANDEIRA_EN : BANDEIRA_PT} /></a>
  </header>

  <!-- 1 · Hero: Exploração em tela cheia, elenco pisando no mapa -->
  <section class="cena hero" id="topo" aria-labelledby="hero-h">
    {heroArte.desktop && heroArte.celular ? (
      <div class="cena-fundo hero-fundo" aria-hidden="true">
        {/* Arte-chave (ilustração composta): redução suave, nunca pixelated. Só a variante da tela é pedida. */}
        <picture class="hero-arte">
          <source media="(min-width: 1024px)" type="image/avif" srcset={hset(heroArte.desktop, heroArte.larguras!.desktop, 'avif')} sizes="100vw" />
          <source media="(min-width: 1024px)" type="image/webp" srcset={hset(heroArte.desktop, heroArte.larguras!.desktop, 'webp')} sizes="100vw" />
          <source type="image/avif" srcset={hset(heroArte.celular, heroArte.larguras!.celular, 'avif')} sizes="100vw" />
          <img src={b(`${heroArte.celular}-780.webp`)} srcset={hset(heroArte.celular, heroArte.larguras!.celular, 'webp')} sizes="100vw" width="941" height="1672" alt="" fetchpriority="low" decoding="async" />
        </picture>
      </div>
    ) : (
    <Mapa id="exploracao" desk="exploracao-d" aD={821 / 600} dfy={0.45} lcp>
      {/* Uma escala por cena: 3x (192) no celular, 4x (256) no desktop. Pés em chão medido. */}
      <Cria s="fogo-ultimate" t={192} td={256} x={66} y={66} dx={66} dy={86} prot ja />
      <Cria s="agua-ultimate" t={192} td={256} x={24} y={62} dx={80} dy={66} flip fase={400} />
      <Cria s="ar-champion" t={192} td={256} x={80} y={45} dx={91} dy={90} flip so="d" fase={1200} />
    </Mapa>
    )}
    <div class="hero-corpo">
      <div class="hero-texto veu-h">
        <img class="hero-logo" src={logo} srcset={`${b('/site/logo-240.webp')} 240w, ${b('/site/logo-320.webp')} 320w, ${logo} 480w`} sizes="(min-width: 1024px) 300px, 156px" width="480" height="503" fetchpriority="high" alt={t.logoAlt} />
        <h1 id="hero-h">{t.h1}</h1>
        <p class="vagas-linha" data-vagas-linha><span class="num-g">{t.hero.vagasNum}</span> <span>{t.hero.vagasTx}</span></p>
      </div>

    </div>
  </section>

  <main id="conteudo" tabindex="-1">
    {VB && (
    <section class="calmo meu-soulmon" id="meu-soulmon" aria-labelledby="meu-h" data-comp data-base={b('/sprites/')} data-el-base={b('/el/')} data-chama={b('/provisorio/chama.svg')} data-linhas={JSON.stringify(LINHAS_B.filter((l) => c.formas.every((fm) => temSprite(`/sprites/${l}-${fm}.webp`))))} data-els={JSON.stringify(u.els)} data-nomes={JSON.stringify(c.nomes)} data-formas={JSON.stringify(c.formas)} data-alt={c.alt} data-outro={t.vb.outro} data-falas={JSON.stringify(t.vb.falas)}>
      <h2 id="meu-h">{t.vb.h2}</h2>
      <div class="meu-palco">
        <img class="sprite meu-sombra" data-meu-sombra src={b('/sprites/fogo-rookie.webp')} width="192" height="192" alt="" aria-hidden="true" loading="lazy" />
        <img class="sprite" data-meu-img hidden width="192" height="192" alt="" />
      </div>
      <p class="meu-info" data-meu-info aria-live="polite"></p>
      <button type="button" class="botao primario" data-meu-sortear>{t.vb.sortear}</button>
    </section>
    )}
    <!-- 2 · O jogo na sua mão: aparelho com o loop real ao lado da demo (Laboratório, scroll no desktop) -->
    {!VB && (
    <section class="cena ciclo" id="ciclo" aria-labelledby="ciclo-h" data-linha-demo={LINHA_DEMO}>
      <div class="ciclo-palco" data-palco>
        <Mapa id="laboratorio" desk="laboratorio-d" aD={841 / 600} fy={0.4} dfy={0.5} />
        <div class="ciclo-texto veu">
          <h2 id="ciclo-h">{c.h2}</h2>
        </div>
        {loop && <Aparelho loop={loop} classe="ciclo-aparelho" alt={j.videoAlt} tocar={j.tocar} erro={j.erro} abrir={j.abrir} auto limpo />}
        <ol class="estagios" data-estatico aria-label={c.listaRotulo}>
          {Formas.map((fm, i) => <li><img class="sprite" src={vazio} data-tarde-src={b(`/sprites/${LINHA_DEMO}-${fm}-128.webp`)} width="128" height="128" alt={`${c.alt} ${c.nomes[i]}`} /><noscript><img class="sprite" src={b(`/sprites/${LINHA_DEMO}-${fm}-128.webp`)} width="128" height="128" alt={`${c.alt} ${c.nomes[i]}`} /></noscript><span>{c.nomes[i]}</span></li>)}
        </ol>
        <div class="demo-cena" data-cena hidden>
          <button type="button" class="demo-fechar" data-demo-fechar><svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M6.4 4 4 6.4 9.6 12 4 17.6 6.4 20l5.6-5.6 5.6 5.6 2.4-2.4-5.6-5.6L20 6.4 17.6 4 12 9.6Z"/></svg>{c.fechar}</button>
          <div class="cena-central">
            {/* Nome da forma; ícone da forma em public/forma/ (enviado pelo dono, 09/11). */}
            <p class="forma-titulo" aria-hidden="true"><span class="ico-forma" data-ico-forma data-forma="rookie"></span><span data-placa>{c.nomes[0]}</span></p>
            <div class="disco-caixa">
              <img class="disco" data-tarde-src={assets.disco.src ? b(assets.disco.src) : undefined} src={vazio} width="240" height="109" alt="" />
              <img class="sprite" data-criatura data-tarde-src={b(`/sprites/${LINHA_DEMO}-rookie.webp`)} src={vazio} width="256" height="256" alt={`${c.alt} ${c.nomes[0]}`} />
              <span class="clarao" data-clarao></span>
              <div class="cristal" aria-hidden="true">
                <img data-c="apagado" src={vazio} data-tarde-src={b(assets.cristalApagado.src)} width="48" height="96" alt="" />
                <img data-c="acendendo" src={vazio} data-tarde-src={b(assets.cristalAcendendo.src)} width="48" height="96" alt="" />
                <img data-c="aceso" src={vazio} data-tarde-src={b(assets.cristalAceso.src)} width="48" height="96" alt="" />
              </div>
            </div>
          </div>
          <div class="lista-bloco" data-tarefas>
          <div class="lista-jogo moldura">
            <span class="maozinha" data-mao aria-hidden="true"><svg viewBox="-1 0 22 15" width="66" height="45" shape-rendering="crispEdges"><g fill="#101418"><rect x='8' y='2' width='11' height='5'/><rect x='2' y='3' width='10' height='11'/><rect x='9' y='5' width='5' height='4'/><rect x='9' y='7' width='5' height='4'/><rect x='9' y='9' width='4' height='4'/><rect x='4' y='1' width='6' height='4'/><rect x='-1' y='2' width='5' height='12'/></g><g fill="#fff"><rect x='9' y='3' width='9' height='3'/><rect x='3' y='4' width='8' height='9'/><rect x='10' y='6' width='3' height='2'/><rect x='10' y='8' width='3' height='2'/><rect x='10' y='10' width='2' height='2'/><rect x='5' y='2' width='4' height='2'/><rect x='0' y='3' width='3' height='10'/></g><g fill="#b8c4cc"><rect x='10' y='8' width='3' height='0.6'/><rect x='10' y='10' width='3' height='0.6'/><rect x='2' y='3' width='1' height='10'/><rect x='4' y='12' width='6' height='1'/></g></svg></span>
            <p class="lista-cab"><span class="rot-hoje">{c.hoje}</span> <span class="rot-missao"><span data-missao aria-live="polite">0/{c.tarefas.length}</span></span></p>
            <ul aria-label={c.tarefasRotulo}>
              {c.tarefas.map((tx, i) => (
                <li class="linha">
                  <button type="button" class="check" role="checkbox" aria-checked="false" aria-label={tx} data-tarefa={i}>
