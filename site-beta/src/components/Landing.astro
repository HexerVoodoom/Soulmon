        <h2 id="inscrever-h">{f.h2}</h2>
        <a class="botao primario grande grupo-cta" href="#entrar" data-cta>{t.cta}</a>
        <p class="grupo-nota">{f.grupo.nota}</p>
      </div>
    </section>

    <section class="calmo faq" id="perguntas" aria-labelledby="faq-h">
      <div class="cen-fundo" aria-hidden="true" style={cen('cen-ilhas')}></div>
      <h2 id="faq-h">{t.faq.h2}</h2>
      <div class="faq-lista">
        {t.faq.itens.map(([q, a]) => (
          <details>
            <summary><img class="faq-seta" src={b(assets.seta.src)} width="48" height="31" alt="" loading="lazy" />{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
      <p class="faq-priv"><a href={t.priv}>{t.faq.privLink}</a></p>
    </section>

    <!-- 10 · Entre no beta: a Guilda inteira, praça do cristal -->
  </main>

  <dialog class="entrar-modal" data-entrar-modal aria-labelledby="em-h" aria-modal="true">
    <button type="button" class="em-x" data-em-fechar aria-label={mo.fechar} data-sa="modal-fechar"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M5.7 4.3 12 10.6l6.3-6.3 1.4 1.4-6.3 6.3 6.3 6.3-1.4 1.4-6.3-6.3-6.3 6.3-1.4-1.4 6.3-6.3-6.3-6.3Z"/></svg></button>
    <p class="em-passo" data-em-contagem data-fmt={mo.passoDe}></p>
    <h2 id="em-h" data-em-h tabindex="-1"></h2>
    <p class="em-tx" data-em-tx></p>
    {[mo.p1, mo.p2, mo.p3].map((p, i) => (
      <div class="em-acoes" data-em-passo={i} hidden={i !== 0} data-h={p.h} data-tx={p.tx}>
        <a class="botao primario" href={PASSO_HREF[i]} target="_blank" rel="noopener noreferrer" data-em-abrir data-clique={i === 0 ? '' : undefined} data-sa={`modal-passo${i + 1}-abrir`}>{p.abrir}</a>
        {'ok' in p && <button type="button" class="botao contorno" data-em-ok data-sa={`modal-passo${i + 1}-ok`}>{p.ok}</button>}
      </div>
    ))}
    <button type="button" class="link em-voltar" data-em-voltar hidden data-sa="modal-voltar">{mo.voltar}</button>
  </dialog>
  <dialog class="popup" data-popup aria-labelledby="popup-h" aria-describedby="popup-p">
    <img class="popup-cristal" src={b(assets.cristalAceso.src)} width="48" height="96" alt="" loading="lazy" />
    <h2 id="popup-h" data-popup-h>{f.okH}</h2>
    <p id="popup-p" data-popup-p>{f.ok}</p>
    <button type="button" class="botao primario" data-popup-share>{f.share}</button>
    <p class="partilha-msg" aria-live="polite" data-popup-msg></p>
    <button type="button" class="link" data-popup-fechar>{f.fechar}</button>
  </dialog>

  <footer class="rodape">
    <img class="rodape-logo" src={b('/marca/logo-160.webp')} srcset={`${b('/marca/logo-160.webp')} 1x, ${b('/marca/logo-320.webp')} 2x`} width="64" height="48" alt="" loading="lazy" />
    <p>{t.rodape.nota}</p>
    <ul>
      <li><a href={t.priv}>{t.rodape.priv}</a></li>
      <li><a href={TERMOS} rel="noopener">{t.rodape.termos}</a></li>
      <li><a href={`mailto:${CONTATO}`}>{t.rodape.contato}</a></li>
      <li><a href={t.outraHome} hreflang={t.outraCod} lang={t.outraCod}>{t.outraNome}</a></li>
    </ul>
    <p class="copy">{t.rodape.copy}</p>
  </footer>

  <button type="button" class="link pular-demo" data-pular-demo hidden>{c.pular}</button>
  {VB && <button type="button" class="companheiro" data-companheiro hidden aria-label={t.vb.tocar}><span class="comp-fala" data-comp-fala hidden><span class="comp-tx" data-comp-tx aria-live="polite"></span><span class="comp-x" role="button" tabindex="0" data-comp-x aria-label={c.fechar}>×</span></span><img class="sprite" data-comp-img width="128" height="128" alt="" /><span class="comp-clarao" aria-hidden="true"></span></button>}
  <div class="fixo" data-fixo><a class="ig ig-fixo" href="https://www.instagram.com/soulmon.app/" target="_blank" rel="noopener noreferrer" aria-label={lang === 'pt' ? 'Instagram do Soulmon' : 'Soulmon on Instagram'} title="Instagram"><Fragment set:html={IG} /></a><a class="botao primario fixo-cta" href="#entrar" aria-label={`${t.cta} · ${t.hero.loja}`}><Fragment set:html={PLAY} /><span data-cta>{t.cta}</span></a></div>
  <dialog class="ramo-modal" data-ramo-modal aria-label={s.ramoModal} data-estagio={s.estagio} data-els={JSON.stringify(u.els)} data-base={b('/el/')} data-nomes={JSON.stringify(c.nomes)}>
    <button type="button" class="ramo-x" data-ramo-fechar aria-label={s.ramoFechar}><svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M5.7 4.3 12 10.6l6.3-6.3 1.4 1.4-6.3 6.3 6.3 6.3-1.4 1.4-6.3-6.3-6.3 6.3-1.4-1.4 6.3-6.3-6.3-6.3Z"/></svg></button>
    <div class="ramo-cont">
      <img class="ramo-img" data-ramo-img width="128" height="128" alt="" />
      <p class="ramo-nome" data-ramo-nome></p>
      <p class="ramo-est" data-ramo-est></p>
      <p class="ramo-el" data-ramo-elw><img data-ramo-elimg width="32" height="32" alt="" /><span data-ramo-elnome></span></p>
    </div>
  </dialog>
  <script src="../scripts/app.ts"></script>
  <script src="../scripts/ramos.ts"></script>
  <script src="../scripts/modal-entrar.ts"></script>
</Base>
