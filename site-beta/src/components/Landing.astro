---
// Página do beta, v3 (docs/site-beta/PLANO-DESIGN.md): "cada rolagem é um lugar".
// 0 barra superior · 1 hero (Exploração) · 2 o jogo na sua mão: aparelho real + demo (Laboratório) · 4 seu Soulmon (Jogos)
// 5 o universo (Hall) · 6 o que você faz (Arena) · 7 trailer (slot, só com midia.trailer.ativo) · 8 como entrar (painel calmo)
// 9 perguntas · 10 entre no beta (Guilda inteira). Ritmo: cena cheia x painel calmo, sem superfície clara.
import Base from '../layouts/Base.astro';
import { b } from '../lib/base';
import Mapa from './Mapa.astro';
import Cria from './Cria.astro';
import Aparelho from './Aparelho.astro';
import midia from '../content/midia.json';
import assets from '../content/assets.json';
import universoDados from '../content/universo.json';
import elenco from '../content/elenco.json';
import { TEXTOS, CONTATO, TERMOS, type Lang } from '../i18n/textos';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = TEXTOS[lang];
const c = t.ciclo; const s = t.soul; const u = t.universo; const e = t.entrar; const f = t.form; const j = t.jogo; const r = t.recursos;
type Video = { src: string; poster: string; posterAvif?: string; posterP?: string; posterPAvif?: string; gameplay: boolean; legenda: string; largura: number; altura: number };
type Print = { id: string; src: string; gameplay: boolean };
// Gameplay: só captura real (gameplay: true). O trailer é edição (rótulo Trailer); a cinemática de abertura ficou fora da v3.
const loopRaw = (midia.videos[lang] as Video[]).find((v) => v.gameplay === true && v.src);
const loop = loopRaw && { ...loopRaw, src: b(loopRaw.src), poster: b(loopRaw.poster), posterAvif: loopRaw.posterAvif && b(loopRaw.posterAvif), posterP: b(loopRaw.posterP!), posterPAvif: loopRaw.posterPAvif && b(loopRaw.posterPAvif) };
const prints = (midia.prints[lang] as Print[]).filter((p) => p.gameplay === true && p.src);
// Trailer: edição com telas reais, cartelas e arte aprovada ainda fora do jogo. Rótulo próprio, nunca gameplay.
const trailerSlot = (midia as unknown as { trailer?: Record<string, { ativo?: boolean; src: string; poster: string; posterP: string; largura: number; altura: number }> }).trailer?.[lang];
const capa = (trailerSlot as unknown as { capa: { desktop: string; celular: string } }).capa;
const trailer = trailerSlot?.ativo ? { ...trailerSlot, src: b(trailerSlot.src), poster: b(trailerSlot.poster), posterP: b(trailerSlot.posterP) } : undefined; // só com ativo:true (trailer conferido quadro a quadro em 06/11)
// Arte-chave do hero (decisão do dono, 06/11): quando existir, substitui mapa + elenco sem mudar layout.
const heroArte = assets.heroArte as { desktop: string | null; celular: string | null; larguras?: { desktop: number[]; celular: number[] } };
const hset = (base: string, ws: number[], ext: string) => ws.map((w) => `${b(base)}-${w}.${ext} ${w}w`).join(', ');
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '';
const strings = {
  share: f.shareTxt, copiado: f.copiado, falhaCopia: f.falhaCopia, erros: f.erros, enviando: f.enviando,
  forma: c.forma, de: c.de, alt: c.alt, formas: c.formas, contato: CONTATO, okH: f.okH, ok: f.ok, esperaH: f.esperaH, espera: f.espera, feito: f.feito,
  cta: t.cta, ctaEspera: t.ctaEspera, vagasEspera: t.hero.vagasEspera, enviarEspera: f.enviarEspera, pausar: j.pausar, tocar: j.tocar,
};
const logo = b(assets.logo.src);
const passos = [assets.passoCard1.src, assets.passoCard2.src, assets.passoCard3.src].map(b);
const HABITA = universoDados.habitantes as Record<string, string>;
const NPCS = ['hall', 'jogos', 'oraculo', 'laboratorio-biblioteca-glifa', 'exploracao', 'cuidados', 'loja-itens', 'loja-decoracao', 'loja-background', 'onboarding', 'ranking-arauto', 'n-cozinheiro', 'n-broto', 'n-corvo', 'laboratorio-pet', 'n-musa'];
const ELS = Object.keys(u.els);
// Vinheta de cada lugar: recorte AMPLIADO num ponto diferente dos fundos de seção (x, y em % do mapa).
const FOCO: Record<string, [number, number]> = { exploracao: [70, 34], jogos: [40, 62], arena: [72, 48], hall: [28, 20], guilda: [28, 30], laboratorio: [70, 50], forja: [50, 50] };
// Capas dos jogos: arte ilustrada 4:3 (public/jogos, src/tools/preparar-capas-jogos.mjs). Título e selo são HTML, nunca na arte.
const capaJogo = (id: string, w: 400 | 800 = 400) => b(`/jogos/capa-${id}-${w}`);
const capaSet = (id: string, ext: string) => `${capaJogo(id, 400)}.${ext} 400w, ${capaJogo(id, 800)}.${ext} 800w`;
const MOSAICO = ['combina', 'arena', 'mente', 'ppt'];
const Formas = c.formas;
// Sorteio: todo o elenco elegível de soulmon/novos (src/tools/elenco.mjs). Compacto: [id, elemento, forma].
const POOL = JSON.stringify(elenco.elegiveis.map((x) => [x.id, x.el, x.forma]));
const lugarDados = universoDados.lugares as Record<string, { npc: string; pt: string; en: string; habita: { pt: string; en: string } }>;
const falas = JSON.stringify(Object.fromEntries(Object.entries(lugarDados).map(([k, v]) => [k, { fala: v[lang], habita: v.habita[lang], npc: b(v.npc) }])));
const printSrc = (id: string, ext: string) => [240, 480, 720].map((w) => `${b(`/print/${id}-${lang}-${w}.${ext}`)} ${w}w`).join(', ');
const cen = (n: string) => `--cen-m:image-set(url(${b(`/dono/${n}-800.avif`)}) type("image/avif"), url(${b(`/dono/${n}-800.webp`)}) type("image/webp"));--cen-d:image-set(url(${b(`/dono/${n}-1400.avif`)}) type("image/avif"), url(${b(`/dono/${n}-1400.webp`)}) type("image/webp"))`;
const vazio = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
---
<Base lang={lang} alternativa={t.outraHome} aqui={t.home} preload>
  <a class="pular" href="#conteudo">{t.pular}</a>

  <header class="topo" data-topo>
    <a class="topo-logo" href="#topo" aria-label={t.logoTopo}><img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-tarde-src={b('/marca/logo-160.webp')} width="160" height="120" alt="" /></a>
    <a class="idioma" href={t.outraHome} hreflang={t.outraCod} lang={t.outraCod}>{t.outraNome}</a>
    <a class="botao compacto topo-cta" href="#inscrever" data-cta data-topo-cta hidden>{t.cta}</a>
  </header>

  <div class="barra" aria-hidden="true" data-barra hidden>
    <span class="barra-capa"></span>
    <span class="barra-trilho"><i data-barra-cheio></i>
      {[0, 1, 2, 3, 4].map((n) => <b class="barra-no" style={`--n:${n}`} data-no></b>)}
    </span>
    <span class="barra-capa baixo"></span>
  </div>

  <!-- 1 · Hero: Exploração em tela cheia, elenco pisando no mapa -->
  <section class="cena hero" id="topo" aria-labelledby="hero-h">
    {heroArte.desktop && heroArte.celular ? (
      <div class="cena-fundo hero-fundo" aria-hidden="true">
        {/* Arte-chave (ilustração composta): redução suave, nunca pixelated. Só a variante da tela é pedida. */}
        <picture class="hero-arte">
          <source media="(min-width: 1024px)" type="image/avif" srcset={hset(heroArte.desktop, heroArte.larguras!.desktop, 'avif')} sizes="100vw" />
          <source media="(min-width: 1024px)" type="image/webp" srcset={hset(heroArte.desktop, heroArte.larguras!.desktop, 'webp')} sizes="100vw" />
          <source type="image/avif" srcset={hset(heroArte.celular, heroArte.larguras!.celular, 'avif')} sizes="100vw" />
          <img src={b(`${heroArte.celular}-780.webp`)} srcset={hset(heroArte.celular, heroArte.larguras!.celular, 'webp')} sizes="100vw" width="941" height="1672" alt="" fetchpriority="low" decoding="async" />
        </picture>
      </div>
    ) : (
    <Mapa id="exploracao" desk="exploracao-d" aD={821 / 600} dfy={0.45} lcp>
      {/* Uma escala por cena: 3x (192) no celular, 4x (256) no desktop. Pés em chão medido. */}
      <Cria s="fogo-ultimate" t={192} td={256} x={66} y={66} dx={66} dy={86} prot ja />
      <Cria s="agua-ultimate" t={192} td={256} x={24} y={62} dx={80} dy={66} flip fase={400} />
      <Cria s="ar-champion" t={192} td={256} x={80} y={45} dx={91} dy={90} flip so="d" fase={1200} />
    </Mapa>
    )}
    <div class="hero-corpo">
      <div class="hero-texto veu-h">
        <img class="hero-logo" src={logo} srcset={`${b('/site/logo-240.webp')} 240w, ${b('/site/logo-320.webp')} 320w, ${logo} 480w`} sizes="(min-width: 1024px) 300px, 156px" width="480" height="503" fetchpriority="high" alt={t.logoAlt} />
        <h1 id="hero-h">{t.h1}</h1>
        <p class="vagas-linha" data-vagas-linha><span class="num-g">{t.hero.vagasNum}</span> <span>{t.hero.vagasTx}</span></p>
      </div>
      {loop && <Aparelho loop={loop} classe="hero-aparelho" rotulo={t.rotulos.gameplay} alt={j.videoAlt} tocar={j.tocar} erro={j.erro} abrir={j.abrir} auto lcp />}
      <div class="hero-acao veu-h">
        <a class="botao primario hero-cta" href="#inscrever" data-cta data-hero-cta>{t.cta}</a>
        <a class="botao contorno hero-ver" href="#ciclo">{t.hero.ver}</a>
        <a class="hero-ver-link" href="#ciclo">{t.hero.ver}</a>
        <p class="loja"><svg class="loja-ico" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M4 8h16l-1.2 12H5.2L4 8Z"/><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M9 10V6a3 3 0 0 1 6 0v4"/></svg>{t.hero.loja}</p>
      </div>
    </div>
  </section>

  <main id="conteudo" tabindex="-1">
    <!-- 2 · O jogo na sua mão: aparelho com o loop real ao lado da demo (Laboratório, scroll no desktop) -->
    <section class="cena ciclo" id="ciclo" aria-labelledby="ciclo-h">
      <div class="ciclo-palco" data-palco>
        <Mapa id="laboratorio" desk="laboratorio-d" aD={841 / 600} fy={0.4} dfy={0.5} />
        <div class="ciclo-texto veu">
          <h2 id="ciclo-h">{c.h2}</h2>
          <p class="frase">{c.frase}</p>
        </div>
        {loop && <Aparelho loop={loop} classe="ciclo-aparelho" rotulo={t.rotulos.gameplay} alt={j.videoAlt} tocar={j.tocar} erro={j.erro} abrir={j.abrir} auto={false} />}
        <ol class="estagios" data-estatico aria-label={c.listaRotulo}>
          {Formas.map((fm, i) => <li><img class="sprite" src={vazio} data-tarde-src={b(`/sprites/planta-${fm}-128.webp`)} width="128" height="128" alt={`${c.alt} ${c.forma} ${i + 1} ${c.de} 5`} /><noscript><img class="sprite" src={b(`/sprites/planta-${fm}-128.webp`)} width="128" height="128" alt={`${c.alt} ${c.forma} ${i + 1} ${c.de} 5`} /></noscript><span>{c.forma} {i + 1} {c.de} 5</span></li>)}
        </ol>
        <div class="demo-cena" data-cena hidden>
          <div class="cena-central">
            <p class="forma-titulo" data-placa aria-hidden="true">{c.forma} 1 {c.de} 5</p>
            <div class="disco-caixa">
              <img class="disco" data-tarde-src={assets.disco.src ? b(assets.disco.src) : undefined} src={vazio} width="240" height="109" alt="" />
              <img class="sprite" data-criatura data-tarde-src={b('/sprites/planta-rookie.webp')} src={vazio} width="256" height="256" alt={`${c.alt} ${c.forma} 1 ${c.de} 5`} />
              <span class="clarao" data-clarao></span>
              <div class="cristal" aria-hidden="true">
                <img data-c="apagado" src={vazio} data-tarde-src={b(assets.cristalApagado.src)} width="48" height="96" alt="" />
                <img data-c="acendendo" src={vazio} data-tarde-src={b(assets.cristalAcendendo.src)} width="48" height="96" alt="" />
                <img data-c="aceso" src={vazio} data-tarde-src={b(assets.cristalAceso.src)} width="48" height="96" alt="" />
              </div>
            </div>
          </div>
          <div class="lista-bloco" data-tarefas>
          <p class="demo-linha"><span class="rotulo rot-demo">{t.rotulos.demo}</span> <span>{c.demo}</span></p>
          <div class="lista-jogo moldura">
            <p class="lista-cab"><span class="rot-hoje">{c.hoje}</span> <span class="rot-missao"><span data-missao aria-live="polite">0/{c.tarefas.length}</span></span></p>
            <ul aria-label={c.tarefasRotulo}>
              {c.tarefas.map((tx, i) => (
                <li class="linha">
                  <button type="button" class="check" role="checkbox" aria-checked="false" aria-label={tx} data-tarefa={i}>
                    <span class="caixa" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="m9.5 16.2-4-4 1.6-1.6 2.4 2.4 7.4-7.4 1.6 1.6-9 9Z"/></svg></span>
                  </button>
                  <span class="linha-nome" aria-hidden="true">{tx}</span>
                </li>
              ))}
            </ul>
          </div>
          </div>
          <div class="ciclo-fim" data-fim hidden>
            <p>{c.fim}</p>
            <a class="botao primario" href="#inscrever" data-cta>{t.cta}</a>
            <button type="button" class="link" data-recomecar>{c.recomecar}</button>
          </div>
          <img class="chama" data-chama src={b('/provisorio/chama.svg')} width="24" height="32" alt="" aria-hidden="true" loading="lazy" />
          <p class="sr" aria-live="polite" data-anuncio></p>
        </div>
      </div>
    </section>

    <!-- 4 · Seu Soulmon: Jogos; número grande, árvore e fichas -->
    <section class="cena soul" id="seu-soulmon" aria-labelledby="soul-h">
      <div class="soul-mosaico" aria-hidden="true" style={`--mosaico:image-set(url(${b('/site/mosaico-elementos.avif')}) type("image/avif"), url(${b('/site/mosaico-elementos.webp')}) type("image/webp"))`}></div>
      <div class="soul-grade">
        <div class="soul-texto veu">
          <h2 id="soul-h">{s.h2}</h2>
          <p class="frase">{s.frase}</p>
          <p class="numero"><span class="num-g">{s.num}</span> <span class="num-tx">{s.numTx}</span></p>
          <p class="numero"><span class="num-pre">{s.num2Pre}</span> <span class="num-g">{s.num2}</span> <span class="num-tx">{s.num2Tx}</span></p>
        </div>
        <div class="sorteio ficha-moldura" role="group" aria-label={s.sorteioRotulo} data-sorteio data-pool={POOL} data-base={b('/sprites/')} data-els={JSON.stringify(u.els)} data-forma={c.forma} data-de={c.de} data-alt={s.altSorteio} data-elemento={s.elemento}>
          <div class="sorteio-palco">
            <div class="sorteio-sombra" data-sort-sombra aria-hidden="true"><span>?</span></div>
            <img class="sprite" data-sort-img hidden width="256" height="256" alt="" decoding="async" />
          </div>
          <p class="sorteio-info" data-sort-info aria-live="polite">{s.sombra}</p>
          <button type="button" class="botao primario sorteio-bt" data-sortear hidden>{s.sortear}</button>
        </div>
        <div class="arvore-bloco veu">
          <h3>{s.arvoreH}</h3>
          <div class="linhas" data-linhas data-rotulo={s.linhaRotulo} hidden>
            <div class="linhas-chips">{s.linhas.map((n, i) => <button type="button" class="chip-linha" data-linha-bt={i} aria-pressed={i === 0 ? 'true' : 'false'}>{n}</button>)}</div>
          </div>
          {['planta', 'fada', 'fogo'].map((lin, li) => (
          <ol class="arvore" data-linha={lin} aria-label={`${s.arvoreRotulo}: ${s.linhas[li]}`}>
              <li class="arvore-linha arvore-caminhos" aria-hidden="true"><span class="arvore-rot">&nbsp;</span><span class="arvore-nos">{s.caminhos.map((cm) => <span class="caminho">{cm}</span>)}</span></li>
              {Formas.map((fm, i) => {
                const tres = i > 0 && i < 4;
                return (
                  <>
                    {i > 0 && <li class="arvore-lig" aria-hidden="true"><Fragment set:html={i === 1 ? '<svg class="lv" viewBox="0 0 300 40" preserveAspectRatio="none"><path class="lg g" d="M150 0C150 22 50 18 50 40"/><path class="lg c" d="M150 0V40"/><path class="lg y" d="M150 0C150 22 250 18 250 40"/></svg><svg class="lh" viewBox="0 0 40 300" preserveAspectRatio="none"><path class="lg g" d="M0 150C22 150 18 46 40 46"/><path class="lg c" d="M0 150H40"/><path class="lg y" d="M0 150C22 150 18 254 40 254"/></svg>' : i === 4 ? '<svg class="lv" viewBox="0 0 300 40" preserveAspectRatio="none"><path class="lg g" d="M50 0C50 22 150 18 150 40"/><path class="lg c" d="M150 0V40"/><path class="lg y" d="M250 0C250 22 150 18 150 40"/></svg><svg class="lh" viewBox="0 0 40 300" preserveAspectRatio="none"><path class="lg g" d="M0 46C22 46 18 150 40 150"/><path class="lg c" d="M0 150H40"/><path class="lg y" d="M0 254C22 254 18 150 40 150"/></svg>' : '<svg class="lv" viewBox="0 0 300 40" preserveAspectRatio="none"><path class="lg g" d="M50 0V40"/><path class="lg c" d="M150 0V40"/><path class="lg y" d="M250 0V40"/></svg><svg class="lh" viewBox="0 0 40 300" preserveAspectRatio="none"><path class="lg g" d="M0 46H40"/><path class="lg c" d="M0 150H40"/><path class="lg y" d="M0 254H40"/></svg>'} /></li>}
                    <li class:list={['arvore-linha', { tres }]}>
                      <span class="arvore-rot">{c.forma} {i + 1}</span>
                      <span class="arvore-nos">
                        {tres && <span class="no oculto" role="img" aria-label={s.descobrir}><span class="sombra-q" aria-hidden="true"><span>?</span></span></span>}
                        <span class="no revelado"><img class="sprite" loading="lazy" src={b(`/sprites/${lin}-${fm}-128.webp`)} width="128" height="128" alt={`${s.linhas[li]}, ${c.forma} ${i + 1} ${c.de} 5`} /></span>
                        {tres && <span class="no oculto" role="img" aria-label={s.descobrir}><span class="sombra-q" aria-hidden="true"><span>?</span></span></span>}
                      </span>
                    </li>
                  </>
                );
              })}
            </ol>
          ))}
          <p class="sr">{s.caminhos.join(', ')}</p>
        </div>
      </div>
    </section>

    <!-- 5 · O universo: Hall, abas pedidas pelo dono -->
    <section class="cena universo" id="universo" aria-labelledby="universo-h">
      <Mapa id="hall" desk="hall-d" aD={821 / 600} fy={0.55} dfy={0.5} />
      <div class="universo-cab veu">
        <h2 id="universo-h">{u.h2}</h2>
        <p class="frase">{u.frase}</p>
      </div>
      <div class="universo-corpo">
        <div class="abas" data-abas data-rotulo={u.abasRotulo} hidden>
          {u.abas.map((a, i) => <button type="button" class="aba" id={`aba-${i}`} data-aba={i}>{a}</button>)}
        </div>
        <div class="painel" id="painel-0" data-painel>
          <h3 class="painel-h">{u.abas[0]}</h3>
          <ul class="grade areas">
            {u.areas.map(([id, nome]) => (
              <li class="area" style={`--fx:${FOCO[id][0] / 100};--fy:${FOCO[id][1] / 100}`}>
                <button type="button" class="area-bt" data-lugar={id} aria-haspopup="dialog">
                {id === 'forja'
                  ? <span class="area-arte pronta"><picture><source type="image/avif" srcset={b('/mapa/forja-760.avif')} /><img loading="lazy" decoding="async" src={b('/mapa/forja-760.webp')} width="760" height="570" alt="" /></picture></span>
                  : <span class="area-arte"><picture><source type="image/avif" srcset={b(`/mapa/${id}-820.avif`)} /><img loading="lazy" decoding="async" src={b(`/mapa/${id}-820.webp`)} width="820" height="1823" alt="" /></picture></span>}
                <span class="area-tx"><strong>{nome}</strong><span>{u.lugares[id]}</span></span>
                </button>
              </li>
            ))}
          </ul>
        </div>
        <div class="painel" id="painel-1" data-painel>
          <h3 class="painel-h">{u.abas[1]}</h3>
          <ul class="grade npcs">
            {NPCS.map((n) => <li class="celula">{HABITA[n]
              ? <button type="button" class="npc-bt" data-lugar={HABITA[n]} data-npc={b(`/npc/${n}.webp`)} data-habita aria-haspopup="dialog" aria-label={`${u.habitanteAlt}: ${u.areas.find(([id]) => id === HABITA[n])?.[1]}`}><img loading="lazy" src={b(`/npc/${n}.webp`)} width="256" height="256" alt="" /></button>
              : <img loading="lazy" src={b(`/npc/${n}.webp`)} width="256" height="256" alt={u.habitanteAlt} />}</li>)}
          </ul>
        </div>
        <div class="painel" id="painel-2" data-painel>
          <h3 class="painel-h">{u.abas[2]}</h3>
          <ul class="grade jogos" tabindex="0" aria-label={u.jogosArte}>
            {u.jogos.map(([id, nome]) => (
              <li class="celula capa-jogo" aria-labelledby={`cj-${id}${id === 'calabouco' ? ` cj-${id}-s` : ''}`}>
                <span class="capa-arte"><picture>
                  <source type="image/avif" srcset={capaSet(id, 'avif')} sizes="(min-width: 768px) 22vw, 44vw" />
                  <img loading="lazy" decoding="async" src={`${capaJogo(id)}.webp`} srcset={capaSet(id, 'webp')} sizes="(min-width: 768px) 22vw, 44vw" width="400" height="300" alt="" />
                </picture>{id === 'calabouco' && <span class="selo-obras" id={`cj-${id}-s`}>{u.emObras}</span>}</span>
                <span class="capa-nome" id={`cj-${id}`}>{nome}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="painel" id="painel-3" data-painel>
          <h3 class="painel-h">{u.abas[3]}</h3>
          <ul class="grade els">
            {ELS.map((id) => <li class="celula"><img class="sprite" loading="lazy" src={b(`/el/${id}.webp`)} width="96" height="96" alt="" /><span>{u.els[id]}</span></li>)}
            <li class="celula combos"><strong class="num-g">{u.combinacoes.split(' ')[0]}</strong><span>{u.combinacoes.split(' ').slice(1).join(' ')}</span><span class="combos-tx">{u.combinacoesTx}</span></li>
          </ul>
        </div>
      </div>
    </section>

    <dialog class="popup npc-modal" role="dialog" data-npc-modal aria-labelledby="npc-h" aria-describedby="npc-p" data-falas={falas} data-morador={u.morador}>
      <img class="npc-modal-img" data-npc-img src={vazio} width="256" height="256" alt="" />
      <h2 id="npc-h" data-npc-h></h2>
      <p id="npc-p" class="npc-fala" data-npc-p></p>
      <button type="button" class="botao primario" data-npc-fechar>{u.fechar}</button>
    </dialog>

    <!-- 6 · O que você faz: Arena, 3 telas reais -->
    {prints.length > 0 && (
      <section class="cena recursos" id="recursos" aria-labelledby="recursos-h">
        <div class="cen-fundo" data-arte aria-hidden="true" style={cen('cen-circuito')}></div>
        <div class="recursos-cab veu">
          <h2 id="recursos-h">{r.h2}</h2>
          <p class="frase">{r.frase}</p>
        </div>
        <ul class="cartoes" tabindex="0" aria-label={r.h2}>
          {r.cartoes.filter(([id]) => prints.some((p) => p.id === id)).map(([id, h, p, alt]) => (
            <li class="cartao">
              {id === 'jogos' ? (
                <figure class="mosaico-jogos" role="img" aria-label={alt}>
                  <p class="rotulo rot-arte">{t.rotulos.arte}</p>
                  <div class="mosaico-grade" aria-hidden="true">
                    {MOSAICO.map((m) => <picture><source type="image/avif" srcset={capaSet(m, 'avif')} sizes="120px" /><img loading="lazy" decoding="async" src={`${capaJogo(m)}.webp`} srcset={capaSet(m, 'webp')} sizes="120px" width="400" height="300" alt="" /></picture>)}
                  </div>
                </figure>
              ) : (
              <p class="rotulo rot-gameplay cartao-selo">{t.rotulos.gameplay}</p>
              <figure class="aparelho mini">
                <div class="casca"><div class="tela">
                  <picture>
                    <source type="image/avif" srcset={printSrc(id, 'avif')} sizes="(min-width: 1024px) 220px, 200px" />
                    <img src={b(`/print/${id}-${lang}-480.webp`)} srcset={printSrc(id, 'webp')} sizes="(min-width: 1024px) 220px, 200px" width="1170" height="2532" alt={alt} loading="lazy" decoding="async" />
                  </picture>
                </div></div>
              </figure>
              )}
              <h3>{h}</h3>
              <p>{p}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- 7 · Trailer de 59 s: telas reais + cartelas + arte aprovada; rotulado Trailer, nunca Gameplay real -->
    {trailer && (
      <section class="calmo trailer" id="trailer" aria-labelledby="trailer-h">
        <div class="trailer-texto">
          <h2 id="trailer-h">{t.video.h2}</h2>
          <p class="frase">{t.video.legenda}</p>
        </div>
        <figure class="trailer-fig">
          <figcaption class="rotulo rot-cine">{t.rotulos.trailer}</figcaption>
          <div class="trailer-moldura">
            {/* Sem autoplay e com som: a capa é um botão; o vídeo (com controles) só aparece depois do play. */}
            <button type="button" class="trailer-capa" data-trailer-capa hidden>
              <picture>
                <source media="(min-width: 768px)" type="image/avif" srcset={`${b(capa.desktop)}-640.avif 640w, ${b(capa.desktop)}-821.avif 821w`} sizes="(min-width: 1024px) 960px, 100vw" />
                <source media="(min-width: 768px)" type="image/webp" srcset={`${b(capa.desktop)}-640.webp 640w, ${b(capa.desktop)}-821.webp 821w`} sizes="(min-width: 1024px) 960px, 100vw" />
                <source type="image/avif" srcset={`${b(capa.celular)}-480.avif 480w, ${b(capa.celular)}-720.avif 720w`} sizes="100vw" />
                <img src={`${b(capa.celular)}-480.webp`} srcset={`${b(capa.celular)}-480.webp 480w, ${b(capa.celular)}-720.webp 720w`} sizes="100vw" width="720" height="900" alt="" loading="lazy" decoding="async" />
              </picture>
              <span class="capa-texto">
                <span class="capa-h">{t.video.capaH}</span>
                <span class="capa-p">{t.video.capaP}</span>
              </span>
              <span class="sr">{j.tocar}: {t.video.alt}</span>
              <span class="trailer-play" aria-hidden="true"><svg viewBox="0 0 16 16" width="40" height="40"><path fill="currentColor" d="M5 2v12l9-6z"/></svg></span>
            </button>
            <video data-trailer hidden controls playsinline preload="none" width={trailer.largura} height={trailer.altura} aria-label={t.video.alt}>
              <source src={trailer.src} type="video/mp4" />
            </video>
            <noscript><video controls playsinline preload="none" poster={`${b(capa.desktop)}-821.webp`} width={trailer.largura} height={trailer.altura} aria-label={t.video.alt}><source src={trailer.src} type="video/mp4" /></video></noscript>
          </div>
        </figure>
      </section>
    )}

    <!-- 8 · Como entrar: painel calmo, passos na moldura de cobre da ficha -->
    <section class="calmo entrar" id="entrar" aria-labelledby="entrar-h">
      <div class="cen-fundo" aria-hidden="true" style={cen('cen-atelier')}></div>
      <div class="entrar-cab">
        <h2 id="entrar-h">{e.h2}</h2>
        <p class="frase">{e.aviso}</p>
      </div>
      <ol class="passos">
        {e.passos.map(([a, b], i) => <li class="passo">{i === 0 ? <a class="passo-link" href="#inscrever"><img class="passo-card" src={passos[i]} width="420" height="525" alt="" loading="lazy" /><span class="passo-tx"><strong><span class="sr">{i + 1}. </span>{a}</strong><span>{b}</span></span></a> : <><img class="passo-card" src={passos[i]} width="420" height="525" alt="" loading="lazy" /><span class="passo-tx"><strong><span class="sr">{i + 1}. </span>{a}</strong><span>{b}</span></span></>}</li>)}
      </ol>
      <ul class="ilhas" aria-hidden="true">{['arena-bosque', 'arena-salao', 'arena-lab'].map((n) => <li><picture><source type="image/avif" srcset={b(`/dono/${n}.avif`)} /><img src={b(`/dono/${n}.webp`)} width="360" height="237" alt="" loading="lazy" decoding="async" /></picture></li>)}</ul>
    </section>

    <div class="divisor" role="presentation"><picture><source media="(min-width: 768px)" srcset={b('/site/divisor.webp')} /><img src={b('/site/divisor-336.webp')} width="336" height="72" alt="" loading="lazy" /></picture></div>

    <!-- 9 · Perguntas -->
    <section class="calmo faq" id="perguntas" aria-labelledby="faq-h">
      <div class="cen-fundo" aria-hidden="true" style={cen('cen-ilhas')}></div>
      <h2 id="faq-h">{t.faq.h2}</h2>
      <div class="faq-lista">
        {t.faq.itens.map(([q, a]) => (
          <details>
            <summary><img class="faq-seta" src={b(assets.seta.src)} width="48" height="31" alt="" loading="lazy" />{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
      <p class="faq-priv"><a href={t.priv}>{t.faq.privLink}</a></p>
    </section>

    <!-- 10 · Entre no beta: a Guilda inteira, praça do cristal -->
    <section class="cena inscrever" id="inscrever" aria-labelledby="inscrever-h">
      <Mapa id="guilda" desk="guilda-fecho-d" aD={841 / 640} fy={0.5} dfy={0.5}>
        {/* 2x nos dois (pixel da criatura perto do pixel do mapa). Pés medidos com grade sobre a cena renderizada. */}
        <Cria s="planta-ultra" t={128} td={128} x={50} y={89} dx={24} dy={47} />
        <Cria s="agua-rookie" t={128} td={128} x={84} y={23} dx={73} dy={72} flip fase={500} />
        <Cria s="som-champion" t={128} td={128} x={16} y={23} dx={79} dy={56} flip fase={900} />
      </Mapa>
      <div class="inscrever-caixa veu">
        <h2 id="inscrever-h">{f.h2}</h2>
        <p class="vagas" data-vagas hidden>{f.esperaPre}</p>
        <noscript><p class="ns">{f.noscript} <a href={`mailto:${CONTATO}`}>{CONTATO}</a></p></noscript>
        <form id="inscricao" hidden novalidate data-form data-sitekey={sitekey} data-idioma={t.idioma} data-strings={JSON.stringify(strings)}>
          <div class="campo">
            <label for="email">{f.email}</label>
            <p class="dica" id="email-dica">{f.dica}</p>
            <input id="email" name="email" type="email" required autocomplete="email" inputmode="email" placeholder={f.exemplo} autocapitalize="off" spellcheck="false" maxlength="254" aria-describedby="email-dica" />
            <p class="erro" id="email-erro" data-erro hidden></p>
          </div>
          <div class="hp" aria-hidden="true"><label>Site<input type="text" name="site" tabindex="-1" autocomplete="off" /></label></div>
          <div id="turnstile" class="turnstile"></div>
          <p class="legal-linha">{f.legalA} <a href={t.priv}>{f.legalLink}</a> {f.legalB}</p>
          <button class="botao primario grande" type="submit" data-enviar><span data-enviar-tx>{f.enviar}</span><span class="cristais" aria-hidden="true"><i></i><i></i><i></i></span></button>
        </form>
        <p class="feito" tabindex="-1" data-feito hidden>{f.feito}</p>
        <div class="partilha">
          <button type="button" class="link" data-share hidden>{f.share}</button>
          <p class="partilha-msg" aria-live="polite" data-partilha-msg></p>
        </div>
      </div>
    </section>
  </main>

  <dialog class="popup" data-popup aria-labelledby="popup-h" aria-describedby="popup-p">
    <img class="popup-cristal" src={b(assets.cristalAceso.src)} width="48" height="96" alt="" loading="lazy" />
    <h2 id="popup-h" data-popup-h>{f.okH}</h2>
    <p id="popup-p" data-popup-p>{f.ok}</p>
    <button type="button" class="botao primario" data-popup-share>{f.share}</button>
    <p class="partilha-msg" aria-live="polite" data-popup-msg></p>
    <button type="button" class="link" data-popup-fechar>{f.fechar}</button>
  </dialog>

  <footer class="rodape">
    <img class="rodape-logo" src={b('/marca/logo-160.webp')} srcset={`${b('/marca/logo-160.webp')} 1x, ${b('/marca/logo-320.webp')} 2x`} width="64" height="48" alt="" loading="lazy" />
    <p>{t.rodape.nota}</p>
    <ul>
      <li><a href={t.priv}>{t.rodape.priv}</a></li>
      <li><a href={TERMOS} rel="noopener">{t.rodape.termos}</a></li>
      <li><a href={`mailto:${CONTATO}`}>{t.rodape.contato}</a></li>
      <li><a href={t.outraHome} hreflang={t.outraCod} lang={t.outraCod}>{t.outraNome}</a></li>
    </ul>
    <p class="copy">{t.rodape.copy}</p>
  </footer>

  <div class="fixo" data-fixo hidden><a class="botao primario" href="#inscrever" data-cta>{t.cta}</a></div>
  <script src="../scripts/app.ts"></script>
</Base>
