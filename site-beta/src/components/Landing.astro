          <p class="sr" aria-live="polite" data-anuncio></p>
        </div>
      </div>
    </section>
    )}

    <!-- 4 · Seu Soulmon: Jogos; número grande, árvore e fichas -->
    <section class="cena soul" id="seu-soulmon" aria-labelledby="soul-h">
      <div class="soul-mosaico" aria-hidden="true" style={`--mosaico:image-set(url(${b('/site/mosaico-elementos.avif')}) type("image/avif"), url(${b('/site/mosaico-elementos.webp')}) type("image/webp"))`}></div>
      <div class="soul-grade">
        <div class="soul-texto veu">
          <h2 id="soul-h">{s.h2}</h2>
          <p class="frase">{s.frase}</p>
          <p class="numero"><span class="num-g">{s.num}</span> <span class="num-tx">{s.numTx}</span></p>
          <p class="numero"><span class="num-pre">{s.num2Pre}</span> <span class="num-g">{s.num2}</span> <span class="num-tx">{s.num2Tx}</span></p>
        </div>
        {!VB && (
        <div class="sorteio ficha-moldura" role="group" aria-label={s.sorteioRotulo} data-sorteio data-pool={POOL} data-base={b('/sprites/')} data-els={JSON.stringify(u.els)} data-forma={c.forma} data-de={c.de} data-alt={s.altSorteio} data-elemento={s.elemento} data-nomes={JSON.stringify(c.nomes)} data-el-base={b('/el/')} data-fusoes={JSON.stringify(fusoes)} data-lang={lang}>
          <div class="sorteio-palco">
            <img class="sorteio-sombra sprite" data-sort-sombra aria-hidden="true" src={b('/sprites/agua-ultimate.webp')} width="256" height="256" alt="" loading="lazy" />
            <img class="sprite" data-sort-img hidden width="256" height="256" alt="" decoding="async" />
          </div>
          {/* Duas linhas: elemento (ícone do elemento) e forma (ícone da forma: PROVISÓRIO até o anexo do dono). */}
          <p class="sorteio-info" data-sort-info aria-live="polite">{s.sombra}</p>
          <button type="button" class="botao primario sorteio-bt" data-sortear hidden>{s.sortear}</button>
        </div>
        )}
        <div class="arvore-bloco veu" data-trilho>
          <h3>{s.arvoreH}</h3>
          <div class="arvore-palco">
          <button type="button" class="seta-linha esq" data-linha-ant aria-label={s.linhaAnt} hidden><svg viewBox="0 0 24 24" width="40" height="40" aria-hidden="true"><path fill="currentColor" d="M15.5 3 6.5 12l9 9 2.1-2.1L10.7 12l6.9-6.9Z"/></svg></button>
          {LINHAS.map(([lin, nomeLin]) => (
          <ol class="arvore" data-linha={lin} aria-label={`${s.arvoreRotulo}: ${nomeLin}`}>
              {Formas.map((fm, i) => {
                const tres = i > 0 && i < 4;
                return (
                  <>
                    {i > 0 && <li class="arvore-lig" aria-hidden="true"><Fragment set:html={i === 1 ? '<svg class="lv" viewBox="0 0 300 40" preserveAspectRatio="none"><path class="lg g" d="M150 0C150 22 50 18 50 40"/><path class="lg c" d="M150 0V40"/><path class="lg y" d="M150 0C150 22 250 18 250 40"/></svg><svg class="lh" viewBox="0 0 40 300" preserveAspectRatio="none"><path class="lg g" d="M0 150C22 150 18 46 40 46"/><path class="lg c" d="M0 150H40"/><path class="lg y" d="M0 150C22 150 18 254 40 254"/></svg>' : i === 4 ? '<svg class="lv" viewBox="0 0 300 40" preserveAspectRatio="none"><path class="lg g" d="M50 0C50 22 150 18 150 40"/><path class="lg c" d="M150 0V40"/><path class="lg y" d="M250 0C250 22 150 18 150 40"/></svg><svg class="lh" viewBox="0 0 40 300" preserveAspectRatio="none"><path class="lg g" d="M0 46C22 46 18 150 40 150"/><path class="lg c" d="M0 150H40"/><path class="lg y" d="M0 254C22 254 18 150 40 150"/></svg>' : '<svg class="lv" viewBox="0 0 300 40" preserveAspectRatio="none"><path class="lg g" d="M50 0V40"/><path class="lg c" d="M150 0V40"/><path class="lg y" d="M250 0V40"/></svg><svg class="lh" viewBox="0 0 40 300" preserveAspectRatio="none"><path class="lg g" d="M0 46H40"/><path class="lg c" d="M0 150H40"/><path class="lg y" d="M0 254H40"/></svg>'} /></li>}
                    {i === 1 && <li class="arvore-linha arvore-caminhos" aria-hidden="true"><span class="arvore-rot">&nbsp;</span><span class="arvore-nos">{s.caminhos.map((cm) => <span class="caminho">{cm}</span>)}</span></li>}
                    <li class:list={['arvore-linha', { tres }]}>
                      <span class="arvore-rot">{c.nomes[i]}</span>
                      <span class="arvore-nos">
                        {tres
                          ? CAMINHOS.map((cm, ci) => (
                              cm === PRINCIPAL[lin] || temSprite(`/sprites/ramos/${lin}-${cm}-${fm}-128.webp`)
                                ? <button type="button" class="no revelado" data-ramo data-ramo-nome={`${nomeLin} · ${s.caminhos[ci]}`} data-ramo-i={i} data-ramo-el={lin} aria-haspopup="dialog"><img class="sprite" loading="lazy" src={b(cm === PRINCIPAL[lin] ? `/sprites/${lin}-${TROCA[`${lin}-${cm}-${fm}`] ?? fm}-128c.webp` : `/sprites/ramos/${lin}-${cm}-${TROCA[`${lin}-${cm}-${fm}`] ?? fm}-128c.webp`)} width="128" height="128" alt={`${nomeLin}, ${s.caminhos[ci]}, ${c.nomes[i]}`} /></button>
                                : <span class="no oculto" role="img" aria-label={s.descobrir}><span class="sombra-q" aria-hidden="true"><span>?</span></span></span>
                            ))
                          : temSprite(`/sprites/${lin}-${fm}-128.webp`)
                            ? <button type="button" class="no revelado" data-ramo data-ramo-nome={nomeLin} data-ramo-i={i} data-ramo-el={lin} aria-haspopup="dialog"><img class="sprite" loading="lazy" src={b(`/sprites/${lin}-${fm}-128c.webp`)} width="128" height="128" alt={`${nomeLin}, ${c.nomes[i]}`} /></button>
                            : <span class="no oculto" role="img" aria-label={s.descobrir}><span class="sombra-q" aria-hidden="true"><span>?</span></span></span>}
                      </span>
                    </li>
                  </>
                );
              })}
            </ol>
          ))}
          <button type="button" class="seta-linha dir" data-linha-prox aria-label={s.linhaProx} hidden><svg viewBox="0 0 24 24" width="40" height="40" aria-hidden="true"><path fill="currentColor" d="M8.5 3 6.4 5.1l6.9 6.9-6.9 6.9L8.5 21l9-9Z"/></svg></button>
          </div>
          <p class="sr">{s.caminhos.join(', ')}</p>
        </div>
      </div>
    </section>

    <!-- 4b · Colete todas as formas (pedido do dono, 09/11). variantes elementais do fogo (caminho Poder) em public/sprites/colete/;
         -->
    <section class="cena calmo colete" id="colete" aria-labelledby="colete-h">
      <Mapa id="jogos" desk="jogos-d" aD={841 / 600} fy={0.5} dfy={0.5} />
      <div class="colete-cab">
        <h2 id="colete-h">{t.colete.h2}</h2>
        <p class="frase">{t.colete.frase}</p>
      </div>
      {/* Colete (dono, 09/11, rodada 2): por forma (Champion, Ultimate), os 3 caminhos lado a lado, cartas do MESMO tamanho, sem destaque central.
          Poder: as 5 variantes reais (E:\Soulmon-assets\site-formas\{champion,ultimate}). Harmonia e Benevolência: a forma de fogo do caminho
          (public/sprites/ramos) + 5 elementos em sombra, PROVISÓRIO até existirem as variantes desses caminhos. */}
      <div class="colete-abas" role="tablist" aria-label={t.colete.h2}>
        {(['champion', 'ultimate'] as const).map((nv, k) => <button type="button" role="tab" class="colete-aba" data-colete-aba={nv} aria-selected={k === 0 ? 'true' : 'false'}><span class="ico-forma" data-forma={nv}></span>{c.nomes[k + 1]}</button>)}
      </div>
      <div class="colete-niveis">
      {(['champion', 'ultimate'] as const).map((nv, k) => (
        <div class="colete-nivel" data-colete-nivel={nv} data-ativo={k === 0 ? '1' : '0'}>
          <h3 class="colete-rot"><span class="ico-forma" data-forma={nv}></span>{c.nomes[k + 1]}</h3>
          {CAMINHOS.map((cm, ci) => {
            const vistos = COLETE[nv][cm] ?? [[`/sprites/ramos/fogo-${cm}-${nv}-128.webp`, u.els.fogo]];
            const sombra = vistos[0][0];
            return (
              <div class="colete-caminho" role="group" aria-label={`${c.nomes[k + 1]} · ${s.caminhos[ci]}`}>
                <h4>{s.caminhos[ci]}</h4>
                <button type="button" class="colete-seta" data-colete-seta="-1" aria-label={s.linhaAnt}>‹</button>
                <ul class="colete-trilho" data-colete-trilho tabindex="0">
                  {vistos.map(([src, nome]) => <li class="colete-item"><img class="sprite" src={b(src)} width="128" height="128" alt={`${nome}, ${s.caminhos[ci]}, ${c.nomes[k + 1]}`} loading="lazy" /><span>{nome}</span></li>)}
                  {Array.from({ length: 8 - vistos.length }, () => <li class="colete-item falta"><img class="sprite" src={b(sombra)} width="128" height="128" alt={t.colete.falta} loading="lazy" /><b aria-hidden="true">?</b><span>?</span></li>)}
                </ul>
                <button type="button" class="colete-seta" data-colete-seta="1" aria-label={s.linhaProx}>›</button>
              </div>
            );
          })}
        </div>
      ))}
      </div>
    </section>
    <!-- 5 · O universo: Hall, abas pedidas pelo dono -->
    <section class="cena universo" id="universo" aria-labelledby="universo-h">
      <Mapa id="hall" desk="hall-d" aD={821 / 600} fy={0.55} dfy={0.5} />
      <div class="universo-cab veu">
        <h2 id="universo-h">{u.h2}</h2>
        <p class="frase">{u.frase}</p>
      </div>
      <div class="universo-corpo">
        <div class="painel" id="painel-0" data-painel>
          <h3 class="painel-h">{u.abas[0]}</h3>
          <ul class="grade areas">
            {u.areas.map(([id, nome]) => (
              <li class="area" style={`--fx:${FOCO[id][0] / 100};--fy:${FOCO[id][1] / 100}`}>
                <button type="button" class="area-bt" data-lugar={id} aria-haspopup="dialog">
                {PREDIO[id] ? <span class="area-arte predio"><img loading="lazy" decoding="async" src={b(PREDIO[id])} alt="" /></span> : <span class="area-arte"><picture><source type="image/avif" srcset={b(`/mapa/${id}-820.avif`)} /><img loading="lazy" decoding="async" src={b(`/mapa/${id}-820.webp`)} width="820" height="1823" alt="" /></picture></span>}
                <span class="area-tx"><strong>{nome}</strong><span>{u.lugares[id]}</span></span>
                </button>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <dialog class="popup npc-modal" role="dialog" data-npc-modal aria-labelledby="npc-h" aria-describedby="npc-p" data-falas={falas} data-morador={u.morador}>
      <img class="npc-modal-img" data-npc-img src={vazio} width="256" height="256" alt="" />
      <h2 id="npc-h" data-npc-h></h2>
      <p id="npc-p" class="npc-fala" data-npc-p></p>
      {/* Minijogos de cada lugar (dono, 09/11): Jogos tem os jogos livres; Arena, a Arena; Exploração, o Endless Rift e a Masmorra. */}
      {Object.entries(JOGOS_POR_LUGAR).map(([lugar, ids]) => (
        <ul class="grade jogos lugar-jogos" data-jogos-de={lugar} hidden aria-label={u.jogosH}>
          {ids.map((id) => (
            <li class="celula capa-jogo">
              <span class="capa-arte"><picture>
                <source type="image/avif" srcset={capaSet(id, 'avif')} sizes="(min-width: 768px) 200px, 40vw" />
                <img loading="lazy" decoding="async" src={`${capaJogo(id)}.webp`} srcset={capaSet(id, 'webp')} sizes="(min-width: 768px) 200px, 40vw" width="400" height="300" alt="" />
              </picture></span>
              <span class="capa-nome">{u.jogos.find(([j]) => j === id)?.[1]}</span>
            </li>
          ))}
        </ul>
      ))}
      <button type="button" class="botao primario" data-npc-fechar>{u.fechar}</button>
    </dialog>


    <!-- 6 · O que você faz: Arena, 3 telas reais -->
    {prints.length > 0 && (
      <section class="cena recursos" id="recursos" aria-labelledby="recursos-h">
        <div class="cen-fundo" data-arte aria-hidden="true" style={cen('cen-circuito')}></div>
        <div class="recursos-cab veu">
          <h2 id="recursos-h">{r.h2}</h2>
          <p class="frase">{r.frase}</p>
        </div>
        <ul class="cartoes" tabindex="0" aria-label={r.h2}>
          {r.cartoes.filter(([id]) => prints.some((p) => p.id === id)).map(([id, h, p, alt]) => (
            <li class:list={['cartao', { 'cartao-combate': id === 'combate', 'cartao-grande': id !== 'jogos' }]}>
              {id === 'jogos' ? (
                <figure class="mosaico-jogos" role="img" aria-label={alt}>
                  <p class="rotulo rot-arte">{t.rotulos.arte}</p>
                  <div class="mosaico-grade" aria-hidden="true">
                    {MOSAICO.map((m) => <picture><source type="image/avif" srcset={capaSet(m, 'avif')} sizes="120px" /><img loading="lazy" decoding="async" src={`${capaJogo(m)}.webp`} srcset={capaSet(m, 'webp')} sizes="120px" width="400" height="300" alt="" /></picture>)}
                  </div>
                </figure>
              ) : (
              <figure class="aparelho mini">
                <div class="casca"><div class="tela">
                  {id === 'combate' ? (
                    <video class="combate-video" poster={b(`/video/combate-${lang}-poster.webp`)} muted loop playsinline autoplay preload="none" width="432" height="962" aria-label={alt}><source src={b(`/video/combate-${lang}.webm`)} type="video/webm" /><source src={b(`/video/combate-${lang}.mp4`)} type="video/mp4" /></video>
                  ) : <picture>
                    {id === 'rift' ? <source type="image/avif" srcset={b('/mapa/exploracao-820.avif')} /> : <source type="image/avif" srcset={printSrc(id, 'avif')} sizes="(min-width: 1024px) 220px, 200px" />}
                    <img src={id === 'rift' ? b('/mapa/exploracao-820.webp') : b(`/print/${id}-${lang}-480.webp`)} srcset={id === 'rift' ? undefined : printSrc(id, 'webp')} sizes="(min-width: 1024px) 220px, 200px" width="1170" height="2532" alt={alt} loading="lazy" decoding="async" />
                  </picture>}
                </div></div>
              </figure>
              )}
              <h3>{h}</h3>
              <p>{p}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- 7 · Trailer de 59 s: telas reais + cartelas + arte aprovada; rotulado Trailer, nunca Gameplay real -->
    {trailer && (
      <section class="cena calmo trailer" id="trailer" aria-labelledby="trailer-h">
        <Mapa id="arena" desk="arena-d" aD={721 / 560} fy={0.5} dfy={0.5} />
        <div class="trailer-texto">
          <h2 id="trailer-h">{t.video.h2}</h2>
          <p class="frase">{t.video.legenda}</p>
        </div>
        <figure class="trailer-fig">
         <div class:list={['trailer-moldura', { 'tem-v': TRAILER_V }]}>
            {/* Sem autoplay e com som: a capa é um botão; o vídeo (com controles) só aparece depois do play. */}
            <button type="button" class="trailer-capa" data-trailer-capa hidden>
              {/* Capa = mapa principal do jogo (dono, 09/11). Paisagem no desktop, retrato no celular quando houver vídeo vertical. */}
              <picture>
                <source media={TRAILER_V ? '(min-width: 768px)' : 'all'} srcset={`${b('/video/trailer-mapa-d-640.webp')} 640w, ${b('/video/trailer-mapa-d-1280.webp')} 1280w`} sizes="(min-width: 1024px) 960px, 100vw" />
                <img src={b('/video/trailer-mapa-m-480.webp')} srcset={`${b('/video/trailer-mapa-m-480.webp')} 480w, ${b('/video/trailer-mapa-m-720.webp')} 720w`} sizes="100vw" width="720" height="1280" alt="" loading="lazy" decoding="async" />
              </picture>
              <span class="sr">{j.tocar}: {t.video.alt}</span>
              <span class="trailer-play" aria-hidden="true"><svg viewBox="0 0 16 16" width="40" height="40"><path fill="currentColor" d="M5 2v12l9-6z"/></svg></span>
            </button>
            {/* Um vídeo só, escolhido pela largura no toque: nada é baixado antes do play. */}
            <video data-trailer data-h={b(`/video/trailer-${lang}-h.mp4`)} data-v={TRAILER_V ? b(`/video/trailer-${lang}-v.mp4`) : undefined} hidden controls playsinline preload="none" aria-label={t.video.alt}></video>
            <noscript><video controls playsinline preload="none" poster={b('/video/trailer-mapa-d-1280.webp')} width="1280" height="720" aria-label={t.video.alt}><source src={b(`/video/trailer-${lang}-h.mp4`)} type="video/mp4" /></video></noscript>
          </div>
        </figure>
      </section>
    )}

    <!-- 8 · Como entrar: painel calmo, passos na moldura de cobre da ficha -->
    <section class="calmo entrar" id="entrar" aria-labelledby="entrar-h">
      <div class="cen-fundo" aria-hidden="true" style={cen('cen-atelier')}></div>
      <div class="entrar-cab">
        <h2 id="entrar-h">{e.h2}</h2>
        <p class="frase">{e.aviso}</p>
      </div>
      <ol class="passos" data-passos data-ativo="0">
        {e.passos.map(([a, b], i) => (
          <li class="passo" data-passo={i}>
            <a class="passo-link" href={PASSO_HREF[i]} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true" data-clique={i === 0 ? '' : undefined}><img class="passo-card" src={passos[i]} width="420" height="525" alt="" loading="lazy" /><span class="passo-tx"><strong>{a}</strong><span>{b}</span></span></a>
            <a class="botao primario passo-btn" href={PASSO_HREF[i]} target="_blank" rel="noopener noreferrer" data-clique={i === 0 ? '' : undefined}><span class="sr">{i + 1}. </span>{a}</a>
            {i === 0 && <span class="maozinha passo-mao" data-passo-mao aria-hidden="true"><Fragment set:html={MAO_SVG} /></span>}
          </li>
        ))}
      </ol>
      <ul class="ilhas" aria-hidden="true">{['arena-bosque', 'arena-salao', 'arena-lab'].map((n) => <li><picture><source type="image/avif" srcset={b(`/dono/${n}.avif`)} /><img src={b(`/dono/${n}.webp`)} width="360" height="237" alt="" loading="lazy" decoding="async" /></picture></li>)}</ul>
    </section>

   <!-- 9 · Perguntas -->
    <section class="cena inscrever" id="inscrever" aria-labelledby="inscrever-h">
      <Mapa id="guilda" desk="guilda-fecho-d" aD={841 / 640} fy={0.5} dfy={0.5} />
      {/* Criaturas numa camada própria, NA FRENTE do véu escuro do texto (dono, 09/11); a planta desceu para sair de cima do formulário. */}
      <Mapa id="guilda" desk="guilda-fecho-d" aD={841 / 640} fy={0.5} dfy={0.5} soCrias>
        <Cria s="planta-ultra" t={88} td={128} x={86} y={99} dx={24} dy={47} />
        <Cria s="agua-rookie" t={128} td={128} x={84} y={23} dx={73} dy={72} flip fase={500} />
        <Cria s="vigor-rookie" t={128} td={128} x={16} y={23} dx={79} dy={56} flipD fase={900} />
