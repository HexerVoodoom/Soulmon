---
import Base from '../layouts/Base.astro';
import midia from '../content/midia.json';
import assets from '../content/assets.json';
import { TEXTOS, CONTATO, TERMOS, type Lang } from '../i18n/textos';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = TEXTOS[lang];
const c = t.ciclo; const s = t.soul; const u = t.universo; const e = t.entrar; const f = t.form;
// Gameplay: só captura real (gameplay: true). A abertura é cinemática e tem slot próprio.
const loops = (midia.videos[lang] as { src: string; poster: string; gameplay: boolean; legenda: string }[]).filter((v) => v.gameplay === true && v.src);
const prints = (midia.prints[lang] as { src: string; alt: string; gameplay: boolean }[]).filter((p) => p.gameplay === true && p.src);
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '';
const strings = { share: f.shareTxt, copiado: f.copiado, falhaCopia: f.falhaCopia, erros: f.erros, enviando: f.enviando, microCompleta: t.microCompleta, forma: c.forma, de: c.de, alt: c.alt, formas: c.formas, contato: CONTATO, okH: f.okH, ok: f.ok, esperaH: f.esperaH, espera: f.espera, feito: f.feito };
const logo = assets.logo.src;
const passos = [assets.passo1.src, assets.passo2.src, assets.passo3.src];
const NPCS = ['hall', 'jogos', 'oraculo', 'laboratorio-biblioteca-glifa', 'exploracao', 'cuidados', 'loja-itens', 'loja-decoracao', 'loja-background', 'onboarding', 'ranking-arauto', 'n-cozinheiro', 'n-broto', 'n-corvo', 'laboratorio-pet', 'n-musa'];
const ELS = Object.keys(u.els);
// Jogos sem arte própria instalada usam sprite/ícone real como provisório.
const capaJogo: Record<string, string> = { combina: '/el/agua.webp', barrage: '/sprites/v-espaco.webp', corrida: '/sprites/planta-champion-128.webp' };
// x, y = onde os pés pisam, em % do mapa inteiro (medido em grade sobre cada arte).
const CENAS = [
  { id: 'jogos', npc: 'jogos', criatura: 'v-luz', nx: 62, ny: 74, cx: 38, cy: 62 },
  { id: 'arena', npc: 'arena', criatura: 'fogo-ultra', nx: 56, ny: 76, cx: 36, cy: 72 },
  { id: 'hall', npc: 'hall-amigos', criatura: 'v-som', nx: 68, ny: 80, cx: 32, cy: 79 },
  { id: 'guilda', npc: 'hall-guilda', criatura: 'v-terra', nx: 66, ny: 50, cx: 36, cy: 49 },
  { id: 'laboratorio', npc: 'laboratorio-stats', criatura: 'agua-rookie', nx: 72, ny: 80, cx: 28, cy: 80 },
].map((x) => ({ ...x, nome: (u.areas as string[][]).find(([id]) => id === x.id)![1], frase: t.mundo.frases[x.id] }));
const FRENTE = ['spark-g', 'el-vida', 'spark-m', 'el-planta', 'spark-p', 'spark-m', 'el-vida', 'spark-g'];
const Formas = c.formas;
---
<Base lang={lang} alternativa={t.outraHome} aqui={t.home} preload>
  <a class="pular" href="#inscrever">{t.pular}</a>
  <div class="barra" aria-hidden="true" data-barra hidden>
    <span class="barra-capa"></span>
    <span class="barra-trilho"><i data-barra-cheio></i>
      {[0, 1, 2, 3, 4].map((n) => <b class="barra-no" style={`--n:${n}`} data-no></b>)}
    </span>
    <span class="barra-capa baixo"></span>
  </div>

  <header class="hero" id="topo">
    <div class="hero-cena">
      <picture class="hero-mapa" aria-hidden="true">
        <source media="(min-width: 900px)" type="image/avif" srcset="/mapa/exploracao-620.avif" />
        <source type="image/avif" srcset="/mapa/exploracao-480.avif" />
        <img src="/mapa/exploracao-480.webp" alt="" width="480" height="1067" fetchpriority="high" decoding="async" />
      </picture>
      <img class="sprite hero-criatura" data-tarde-src="/sprites/fogo-ultimate.webp" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" width="256" height="256" decoding="async" alt={t.heroAlt} />
      <noscript><img class="sprite hero-criatura" src="/sprites/fogo-ultimate.webp" width="256" height="256" alt={t.heroAlt} /></noscript>
    </div>
    <div class="hero-barra">
      <a href={t.home} class="logo"><img src="/site/logo-240.webp" srcset={`/site/logo-240.webp 240w, ${logo} 480w`} sizes="(min-width: 900px) 240px, 100px" width="240" height="252" fetchpriority="low" alt={t.logoAlt} /></a>
      <a class="idioma" href={t.outraHome} hreflang={t.outraCod} lang={t.outraCod}>{t.outraNome}</a>
    </div>
    <div class="hero-corpo">
      <h1>{t.h1}</h1>
      <div class="hero-acao">
        <a class="botao" href="#inscrever">{t.cta}</a>
        <p class="micro" data-micro>{t.micro}</p>
      </div>
    </div>
  </header>

  <main>
    <section class="ciclo" id="ciclo" aria-labelledby="ciclo-h">
      <div class="ciclo-palco" data-palco>
        <div class="ciclo-texto">
          <h2 id="ciclo-h">{c.h2}</h2>
          <p class="demo">{c.demo}</p>
        </div>
        <ol class="estagios" data-estatico aria-label={c.listaRotulo}>
          {Formas.map((fm, i) => <li><img class="sprite" loading="lazy" src={`/sprites/planta-${fm}-128.webp`} width="128" height="128" alt={`${c.alt} ${c.forma} ${i + 1} ${c.de} 5`} /><span>{c.forma} {i + 1} {c.de} 5</span></li>)}
        </ol>
        <div class="demo-cena" data-cena hidden>
          <div class="cena-central">
            <p class="forma-titulo" data-placa aria-hidden="true">{c.forma} 1 {c.de} 5</p>
            <div class="disco-caixa">
              <img class="disco" data-tarde-src={assets.disco.src ?? undefined} src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" width="240" height="109" alt="" />
              <img class="sprite" data-criatura data-tarde-src="/sprites/planta-rookie.webp" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" width="256" height="256" alt={`${c.alt} ${c.forma} 1 ${c.de} 5`} />
              <span class="clarao" data-clarao></span>
              <div class="cristal" aria-hidden="true">
                <img data-c="apagado" src={assets.cristalApagado.src} width="48" height="96" alt="" loading="lazy" />
                <img data-c="acendendo" src={assets.cristalAcendendo.src} width="48" height="96" alt="" loading="lazy" />
                <img data-c="aceso" src={assets.cristalAceso.src} width="48" height="96" alt="" loading="lazy" />
              </div>
            </div>
          </div>
          <div class="lista-jogo" data-tarefas>
            <p class="lista-titulo" aria-hidden="true">{c.listaTitulo}</p>
            <ul aria-label={c.tarefasRotulo}>
              {c.tarefas.map((tx, i) => (
                <li class="linha">
                  <span class="linha-nome">{tx}</span>
                  <button type="button" class="check" role="checkbox" aria-checked="false" aria-label={tx} data-tarefa={i}>
                    <span class="caixa" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="m9.5 16.2-4-4 1.6-1.6 2.4 2.4 7.4-7.4 1.6 1.6-9 9Z"/></svg></span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
          <div class="ciclo-fim" data-fim hidden>
            <p>{c.fim}</p>
            <a class="botao" href="#inscrever">{t.cta}</a>
            <button type="button" class="link" data-recomecar>{c.recomecar}</button>
          </div>
          <img class="chama" data-chama src="/provisorio/chama.svg" width="24" height="32" alt="" aria-hidden="true" loading="lazy" />
          <p class="sr" aria-live="polite" data-anuncio></p>
        </div>
      </div>
    </section>

    {(loops.length > 0 || prints.length > 0) && (
      <section class="prova" id="prova" aria-labelledby="prova-h">
        <h2 id="prova-h">{t.prova.h2}</h2>
        <div class="prova-midia">
          {loops.map((v) => <figure><video src={v.src} poster={v.poster} muted loop playsinline controls preload="none" width="360" height="800"></video>{v.legenda && <figcaption>{v.legenda}</figcaption>}</figure>)}
          {prints.map((p) => <img src={p.src} alt={p.alt} loading="lazy" />)}
        </div>
      </section>
    )}

    <section class="soul" id="seu-soulmon" aria-labelledby="soul-h">
      <div class="soul-texto">
        <h2 id="soul-h">{s.h2}</h2>
        <ul class="fatos">{s.fatos.map((x) => <li>{x}</li>)}</ul>
      </div>
      <ol class="arvore" aria-label={s.arvoreRotulo}>
        {Formas.map((fm, i) => {
          const tres = i > 0 && i < 4;
          return (
            <li class:list={['arvore-linha', { tres }]}>
              {tres && <span class="no oculto"><img class="sprite" loading="lazy" src={`/sprites/planta-${fm}-128.webp`} width="128" height="128" alt="" /><span class="q" aria-hidden="true">?</span><span class="sr">{s.oculta}</span></span>}
              <span class="no revelado"><img class="sprite" loading="lazy" src={`/sprites/planta-${fm}-128.webp`} width="128" height="128" alt={`${c.alt} ${c.forma} ${i + 1} ${c.de} 5`} /></span>
              {tres && <span class="no oculto"><img class="sprite" loading="lazy" src={`/sprites/planta-${fm}-128.webp`} width="128" height="128" alt="" /><span class="q" aria-hidden="true">?</span><span class="sr">{s.oculta}</span></span>}
              {i < 4 && <img class="seta" src={assets.seta.src} width="48" height="31" alt="" loading="lazy" />}
            </li>
          );
        })}
      </ol>
    </section>

    <section class="universo" id="universo" aria-labelledby="universo-h">
      <h2 id="universo-h">{u.h2}</h2>
      <div class="abas" data-abas data-rotulo={u.abasRotulo} hidden>
        {u.abas.map((a, i) => <button type="button" class="aba" id={`aba-${i}`} data-aba={i}>{a}</button>)}
      </div>
      <div class="painel" id="painel-0" data-painel>
        <h3 class="painel-h">{u.abas[0]}</h3>
        <ul class="grade areas">
          {u.areas.map(([id, nome]) => <li class="area"><img loading="lazy" src={`/mapa/${id}-480.webp`} width="480" height="849" alt={nome} /><span>{nome}</span></li>)}
        </ul>
      </div>
      <div class="painel" id="painel-1" data-painel>
        <h3 class="painel-h">{u.abas[1]}</h3>
        <ul class="grade npcs">
          {NPCS.map((n) => <li class="celula"><img loading="lazy" src={`/npc/${n}.webp`} width="256" height="256" alt={u.habitanteAlt} /></li>)}
        </ul>
      </div>
      <div class="painel" id="painel-2" data-painel>
        <h3 class="painel-h">{u.abas[2]}</h3>
        <ul class="grade jogos">
          {u.jogos.map(([id, nome]) => <li class="celula"><img class:list={[{ sprite: capaJogo[id] }]} loading="lazy" src={capaJogo[id] ?? `/lote/${id}.webp`} width="256" height="256" alt="" /><span>{nome}</span></li>)}
        </ul>
      </div>
      <div class="painel" id="painel-3" data-painel>
        <h3 class="painel-h">{u.abas[3]}</h3>
        <ul class="grade els">
          {ELS.map((id) => <li class="celula"><img class="sprite" loading="lazy" src={`/el/${id}.webp`} width="96" height="96" alt="" /><span>{u.els[id]}</span></li>)}
          {Array.from({ length: 10 }).map(() => <li class="celula vazia"><span class="q">?</span><span class="sr">{u.ocultoRotulo}</span></li>)}
        </ul>
      </div>
    </section>

    <section class="abertura" id="abertura" aria-labelledby="abertura-h">
      <div class="abertura-texto">
        <h2 id="abertura-h">{t.video.h2}</h2>
        <p>{t.video.legenda}</p>
      </div>
      <figure class="abertura-video">
        <video hidden data-abertura data-poster={midia.abertura.poster} src={midia.abertura.src} controls playsinline preload="none" width="720" height="1280" aria-labelledby="abertura-h"></video>
        <noscript><img src={midia.abertura.poster} width="720" height="1280" alt="" loading="lazy" /></noscript>
      </figure>
    </section>

    <section class="mundo" id="mundo" aria-labelledby="mundo-h">
      <div class="mundo-palco" data-mundo>
        <div class="mundo-texto">
          <h2 id="mundo-h">{t.mundo.h2}</h2>
          <p>{t.mundo.frase}</p>
        </div>
        {CENAS.map((cn) => (
          <figure class="cena" data-cn>
            <div class="c-plano" data-v="-110">
              <img class="c-meio" loading="lazy" src={`/mapa/${cn.id}-480.webp`} width="480" height="1067" alt="" />
              <img class="c-npc" style={`--x:${cn.nx}%;--y:${cn.ny}%`} loading="lazy" src={`/npc/${cn.npc}.webp`} width="256" height="256" alt="" />
              <img class="c-cria sprite" style={`--x:${cn.cx}%;--y:${cn.cy}%`} loading="lazy" src={`/sprites/${cn.criatura}.webp`} width={cn.criatura.startsWith('v-') ? 128 : 256} height={cn.criatura.startsWith('v-') ? 128 : 256} alt="" />
            </div>
            <figcaption><strong>{cn.nome}</strong> <span>{cn.frase}</span></figcaption>
          </figure>
        ))}
        <div class="frente" aria-hidden="true" data-frente>
          {FRENTE.map((n, i) => <img style={`--i:${i}`} data-v={String(-500 - i * 90)} loading="lazy" src={n.startsWith('el-') ? `/el/${n.slice(3)}.webp` : `/site/${n}.webp`} width="48" height="48" alt="" />)}
        </div>
      </div>
    </section>

    <section class="entrar" id="entrar" aria-labelledby="entrar-h">
      <h2 id="entrar-h">{e.h2}</h2>
      <ol class="passos">
        {e.passos.map(([a, b], i) => <li><span class="medalha"><img src={passos[i]} width="96" height="96" alt="" loading="lazy" /><span class="num">{i + 1}</span></span><strong>{a}</strong><span>{b}</span></li>)}
      </ol>
      <p class="aviso-vaga">{e.aviso}</p>
    </section>

    <section class="faq" id="perguntas" aria-labelledby="faq-h">
      <h2 id="faq-h">{t.faq.h2}</h2>
      {t.faq.itens.map(([q, a]) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
      <p class="faq-priv"><a href={t.priv}>{t.faq.privLink}</a></p>
    </section>

    <section class="inscrever" id="inscrever" aria-labelledby="inscrever-h">
      <h2 id="inscrever-h">{f.h2}</h2>
      <p class="vagas" data-vagas hidden>{f.esperaPre}</p>
      <noscript><p class="ns">{f.noscript} <a href={`mailto:${CONTATO}`}>{CONTATO}</a></p></noscript>
      <form id="inscricao" hidden novalidate data-form data-sitekey={sitekey} data-idioma={t.idioma} data-strings={JSON.stringify(strings)}>
        <div class="campo">
          <label for="email">{f.email}</label>
          <input id="email" name="email" type="email" required autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false" maxlength="254" />
        </div>
        <div class="hp" aria-hidden="true"><label>Site<input type="text" name="site" tabindex="-1" autocomplete="off" /></label></div>
        <div id="turnstile" class="turnstile"></div>
        <button class="botao grande" type="submit" data-enviar>{f.enviar}</button>
        <p class="legal-linha">{f.legalA} <a href={t.priv}>{f.legalLink}</a> {f.legalB}</p>
        <p class="erro" role="alert" data-erro hidden></p>
        <p class="feito" role="status" data-feito hidden></p>
      </form>
      <div class="partilha">
        <button type="button" class="link" data-share hidden>{f.share}</button>
        <button type="button" class="link" data-copiar hidden>{f.copiar}</button>
        <p class="partilha-msg" aria-live="polite" data-partilha-msg></p>
      </div>
    </section>
  </main>

  <dialog class="popup" data-popup aria-labelledby="popup-h" aria-describedby="popup-p">
    <img src={assets.cristalAceso.src} width="48" height="96" alt="" loading="lazy" />
    <h2 id="popup-h" data-popup-h>{f.okH}</h2>
    <p id="popup-p" data-popup-p>{f.ok}</p>
    <button type="button" class="botao" data-popup-fechar>{f.fechar}</button>
  </dialog>

  <footer class="rodape">
    <p>{t.rodape.nota}</p>
    <ul>
      <li><a href={t.priv}>{t.rodape.priv}</a></li>
      <li><a href={TERMOS} rel="noopener">{t.rodape.termos}</a></li>
      <li><a href={`mailto:${CONTATO}`}>{t.rodape.contato}</a></li>
      <li><a href={t.outraHome} hreflang={t.outraCod} lang={t.outraCod}>{t.outraNome}</a></li>
    </ul>
  </footer>

  <div class="fixo" data-fixo hidden><a class="botao" href="#inscrever">{t.cta}</a></div>
  <script src="../scripts/app.ts"></script>
</Base>
